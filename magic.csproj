<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Magic</RootNamespace>
    <MagicEnableAiMutationDiagnostics
      Condition="'$(MagicEnableAiMutationDiagnostics)' == '' and '$(Configuration)' == 'Debug'">true</MagicEnableAiMutationDiagnostics>
    <MagicEnableAiMutationDiagnostics
      Condition="'$(MagicEnableAiMutationDiagnostics)' == ''">false</MagicEnableAiMutationDiagnostics>
    <DefineConstants
      Condition="'$(MagicEnableAiMutationDiagnostics)' == 'true'">$(DefineConstants);MAGIC_AI_MUTATION_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Architecture analyzer projects are independent tooling, not game/runtime sources. -->
    <Compile Remove="tools/architecture/**/*.cs" />
    <!-- Standalone content authoring CLI links shared pure-CLR sources into its own executable. -->
    <Compile Remove="tools/content_json_validation/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="tools/architecture/Magic.ArchitectureAnalyzers/Magic.ArchitectureAnalyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="tools/architecture/layer_rules.json" />
    <AdditionalFiles Include="tools/architecture/layer_baseline.json" />
  </ItemGroup>
</Project>
