[gd_resource type="Resource" script_class="BattleEncounterDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleEncounterDef.cs" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleNodeOperationObjectiveDef.cs" id="2_objective"]
[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleOperationNodeDef.cs" id="3_node"]
[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleEncounterWorldResolutionDef.cs" id="4_resolution"]

[sub_resource type="Resource" id="Resource_west_node"]
script = ExtResource("3_node")
node_id = &"west_mist_seal"
display_name = "西侧雾印"
zone_id = &"west_mist_seal_zone"
placement_edge = 1
placement_depth = 3

[sub_resource type="Resource" id="Resource_east_node"]
script = ExtResource("3_node")
node_id = &"east_mist_seal"
display_name = "东侧雾印"
zone_id = &"east_mist_seal_zone"
placement_edge = 2
placement_depth = 3

[sub_resource type="Resource" id="Resource_objective"]
script = ExtResource("2_objective")
operation_nodes = Array[ExtResource("3_node")]([SubResource("Resource_west_node"), SubResource("Resource_east_node")])

[sub_resource type="Resource" id="Resource_resolution"]
script = ExtResource("4_resolution")
player_success_mode = 0
player_failure_mode = 0
draw_mode = 0
suppression_steps = 0

[resource]
script = ExtResource("1_encounter")
encounter_id = &"mist_hollow_node_operation"
display_name = "净化迷雾节点"
roster_profile_id = &"mist_hollow"
objective = SubResource("Resource_objective")
world_resolution = SubResource("Resource_resolution")
