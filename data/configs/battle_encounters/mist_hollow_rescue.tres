[gd_resource type="Resource" script_class="BattleEncounterDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleEncounterDef.cs" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleRescueObjectiveDef.cs" id="2_objective"]
[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleScenarioActorDef.cs" id="3_actor"]
[ext_resource type="Script" path="res://scripts/systems/battle/content/BattleEncounterWorldResolutionDef.cs" id="4_resolution"]

[sub_resource type="Resource" id="Resource_objective"]
script = ExtResource("2_objective")
target_actor_id = &"captured_scout"

[sub_resource type="Resource" id="Resource_actor"]
script = ExtResource("3_actor")
actor_id = &"captured_scout"
template_id = &"militia"
display_name = "被俘斥候"
spawn_zone_id = &"east_prison"
spawn_edge = 2
spawn_depth = 3

[sub_resource type="Resource" id="Resource_resolution"]
script = ExtResource("4_resolution")
player_success_mode = 0
player_failure_mode = 0
draw_mode = 0
suppression_steps = 0

[resource]
script = ExtResource("1_encounter")
encounter_id = &"mist_hollow_rescue"
display_name = "营救被俘斥候"
roster_profile_id = &"mist_hollow"
objective = SubResource("Resource_objective")
scenario_actors = Array[ExtResource("3_actor")]([SubResource("Resource_actor")])
world_resolution = SubResource("Resource_resolution")
