[sub_resource type="Resource" id="Combat_heartbreak_burst"]
script = ExtResource("2_combat")
skill_id = &"weapon_sword_heartbane_heartbreak_burst"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 1
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
attack_resolution_mode = &"direct_effect"
cooldown_tu = 0
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"weapon", &"psychic"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_heartbreak_burst_damage"), SubResource("Effect_heartbreak_burst_stunned"), SubResource("Effect_heartbreak_burst_consume_rend")])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_sword_heartbane_heartbreak_burst"
display_name = "心碎爆发"
icon_id = &"weapon_sword_heartbane_heartbreak_burst"
description = "装备技能。只能对拥有至少3层情感撕裂的敌人使用，造成4D6 psychic伤害，施加30TU震慑，并消耗目标的情感撕裂；噬心者来源每场战斗1次。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"heartbane", &"psychic", &"weapon"])
learn_source = &"innate"
combat_profile = SubResource("Combat_heartbreak_burst")
