[gd_resource type="Resource" script_class="SkillDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_gale_push"]
script = ExtResource("1_effect")
effect_type = &"forced_move"
effect_target_team_filter = &"enemy"
forced_move_mode = &"knockback"
forced_move_distance = 2
save_dc = 14
save_dc_mode = &"static"
save_ability = &"strength"
save_tag = &"strength"

[sub_resource type="Resource" id="Combat_gale_push"]
script = ExtResource("2_combat")
skill_id = &"weapon_bow_windbow_gale_push"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 6
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
stamina_cost = 12
cooldown_tu = 60
attack_resolution_mode = &"direct_effect"
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
required_weapon_families = Array[StringName]([&"bow"])
delivery_categories = Array[StringName]([&"equipment", &"windbow", &"bow", &"wind", &"control", &"displacement", &"weapon"])
projectile_kind = &"magical"
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_gale_push")])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_bow_windbow_gale_push"
display_name = "风压推射"
icon_id = &"weapon_bow_windbow_gale_push"
description = "装备技能。1AP、12体力，冷却 60TU；选择 6 格内敌人，不造成伤害；目标进行 strength DC14 检定，失败时沿持弓者到目标的主轴方向被推离最多 2 格。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"windbow", &"bow", &"wind", &"control", &"displacement"])
learn_source = &"innate"
combat_profile = SubResource("Combat_gale_push")
