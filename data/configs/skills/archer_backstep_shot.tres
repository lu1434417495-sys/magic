[resource]
script = ExtResource("5_vyr5k")
skill_id = &"archer_backstep_shot"
display_name = "后跃射"
icon_id = &"archer_backstep_shot"
description = "使用时先选择一名敌人，再选择一个使你远离目标的正交方向；使用弓发动一次标准武器攻击，结算后沿该方向直线后撤最多2格。后撤不消耗移动力，不能转弯或绕路，受阻时停在阻挡前；后撤正常处理地形、屏障与位置变化效果。无法主动移动时不能使用。"
level_description_template = "使用弓发动一次标准武器攻击；使用时选择远离目标的正交方向，攻击结算后沿该方向直线后撤最多2格，消耗1AP/{stamina}体力，冷却{cooldown}TU{accuracy}"
