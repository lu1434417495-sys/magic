[gd_resource type="Resource" script_class="SkillDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_oath_judgment_damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_target_team_filter = &"enemy"
damage_tag = &"radiant"
dice_count = 4
dice_sides = 6
required_target_status_id = &"oathscar_oath_mark"
required_target_status_min_stacks = 4
required_target_status_source_selector = &"source"

[sub_resource type="Resource" id="Effect_oath_judgment_stunned"]
script = ExtResource("1_effect")
effect_type = &"status"
effect_target_team_filter = &"enemy"
status_id = &"stunned"
duration_tu = 30
power = 1
lock_counterattack = true
lock_guard = true
lock_dodge_bonus = true
lock_crit = true
required_target_status_id = &"oathscar_oath_mark"
required_target_status_min_stacks = 4
required_target_status_source_selector = &"source"

[sub_resource type="Resource" id="Effect_oath_judgment_consume_mark"]
script = ExtResource("1_effect")
effect_type = &"erase_status"
effect_target_team_filter = &"enemy"
status_id = &"oathscar_oath_mark"
required_target_status_id = &"oathscar_oath_mark"
