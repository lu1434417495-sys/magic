[gd_resource type="Resource" script_class="SkillDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_ash_heal"]
script = ExtResource("1_effect")
effect_type = &"heal"
effect_target_team_filter = &"ally"
dice_count = 2
dice_sides = 10

[sub_resource type="Resource" id="Effect_ash_attack"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_target_team_filter = &"enemy"
damage_tag = &"fire"
damage_tags = Array[StringName]([&"fire"])
dice_count = 3
dice_sides = 10

[sub_resource type="Resource" id="Combat_ash_fire"]
script = ExtResource("2_combat")
skill_id = &"equipment_phoenix_rebirth_ash_ring_fire"
target_mode = &"unit"
target_team_filter = &"any"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 1
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
attack_resolution_mode = &"direct_effect"
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"equipment", &"phoenix_rebirth", &"heal", &"fire"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_ash_heal"), SubResource("Effect_ash_attack")])

[resource]
script = ExtResource("3_skill")
skill_id = &"equipment_phoenix_rebirth_ash_ring_fire"
display_name = "灰烬之火"
icon_id = &""
description = "装备技能。消耗1 AP：选择自身或1格内友方时恢复2D10 HP；选择1格内敌人时造成3D10 fire。两个分支共享每个世界日一次的装备实例次数。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"phoenix_rebirth", &"heal", &"fire", &"legendary"])
learn_source = &"innate"
combat_profile = SubResource("Combat_ash_fire")
