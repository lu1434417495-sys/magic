[resource]
script = ExtResource("3_skill")
skill_id = &"archer_hunter_mark"
display_name = "猎人标记"
icon_id = &"archer_hunter_mark"
description = "标记一个猎物。施放者本人以武器命中该目标时，额外造成同次攻击伤害并获得猎人标记熟练度；其他单位不会触发该奖励。等级提升会增加持续时间、射程，并降低体力与冷却压力；5级额外伤害提升为2D4。"
level_description_template = "标记目标{duration}TU；施放者武器命中目标额外{bonus_damage}伤害。射程{range}，消耗{ap}AP/{stamina}体力，冷却{cooldown}TU。"
