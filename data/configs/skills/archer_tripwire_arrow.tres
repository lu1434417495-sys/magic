terrain_contact_mode = &"interrupt_movement_on_failed_save"
terrain_effective_trigger_count = 1
terrain_requires_ground_contact = true
terrain_recheck_from_inside = true
terrain_max_active_instances_per_source = 1
terrain_replace_existing_from_source = true
