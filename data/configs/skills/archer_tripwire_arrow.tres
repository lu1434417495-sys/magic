[sub_resource type="Resource" id="Combat_tripwire"]
script = ExtResource("2_combat")
skill_id = &"archer_tripwire_arrow"
projectile_kind = &"nonmagical"
target_mode = &"ground"
target_team_filter = &"enemy"
target_selection_mode = &"single_coord"
range_value = 0
weapon_range_policy = &"current_weapon"
area_pattern = &"line"
area_value = 1
area_direction_mode = &"target_vector_perpendicular"
requires_los = true
ground_effect_require_full_area = true
ground_effect_require_empty = true
ground_effect_require_traversable = true
ap_cost = 1
stamina_cost = 20
cooldown_tu = 80
level_overrides = {
2: {
"stamina_cost": 18
},
4: {
"cooldown_tu": 70
}
}
mastery_trigger_mode = &"terrain_effective_trigger"
mastery_amount_mode = &"per_target_rank"
required_weapon_families = Array[StringName]([&"bow"])
allows_natural_weapon = false
ai_tags = Array[StringName]([&"ground_control", &"route_denial"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_tripwire_l0_l1"), SubResource("Effect_tripwire_l2"), SubResource("Effect_tripwire_l3"), SubResource("Effect_tripwire_l4"), SubResource("Effect_tripwire_l5")])

[resource]
script = ExtResource("3_skill")
skill_id = &"archer_tripwire_arrow"
display_name = "绊索箭"
icon_id = &""
description = "需要装备弓。选择弓射程内一处空旷、可通行且视线可达的地格，在那里布置一条垂直于射击方向的3格绊索。只有地面移动的敌人会触发：敌人进入绊索，或在新一次移动指令开始时已经站在绊索上，进行一次敏捷豁免；成功则本次移动继续且不消耗绊索次数，同一移动指令不再对这条绊索判定；失败则立即停在当前格并消耗1次有效阻挡。普通移动失败仍支付原选定路径的全部移动力；冲锋与技能步进会中止后续路径，冲锋不会发动终点攻击；强制位移会停止剩余位移。飞行、传送、交换、生成与复活不触发。每名使用者同时只能保留一条绊索，再次施放会替换旧绊索。绊索不会因使用者倒下而消失。"
level_description_template = "布置3格绊索，敏捷豁免DC{dc}，失败拦停并消耗1次阻挡；可阻挡{triggers}次，持续{duration}TU，射程随当前弓，消耗{ap}AP/{stamina}体力，冷却{cooldown}TU"
level_description_configs = {
	"0": {
		"dc": "12",
		"triggers": "1",
		"duration": "60",
		"ap": "1",
		"stamina": "20",
		"cooldown": "80"
	},
	"1": {
		"dc": "12",
		"triggers": "1",
		"duration": "60",
		"ap": "1",
		"stamina": "20",
		"cooldown": "80"
	},
	"2": {
		"dc": "12",
