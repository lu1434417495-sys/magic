[gd_resource type="Resource" script_class="SkillDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatDamageSegmentDef.cs" id="1_segment"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="2_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="3_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="4_skill"]

[sub_resource type="Resource" id="Segment_fire"]
script = ExtResource("1_segment")
damage_tag = &"fire"
damage_tags = Array[StringName]([&"fire"])
dice_count = 1
dice_sides = 10
double_dice_on_critical = true

[sub_resource type="Resource" id="Effect_fire_strike"]
script = ExtResource("2_effect")
effect_type = &"damage"
effect_target_team_filter = &"enemy"
damage_tag = &"physical_blunt"
damage_tags = Array[StringName]([&"physical_blunt"])
dice_count = 1
dice_sides = 8
resolve_as_weapon_attack = true
extra_damage_segments = Array[ExtResource("1_segment")]([SubResource("Segment_fire")])

[sub_resource type="Resource" id="Combat_fire_strike"]
script = ExtResource("3_combat")
skill_id = &"equipment_phoenix_rebirth_gauntlet_fire_strike"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 1
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"equipment", &"phoenix_rebirth", &"unarmed", &"melee", &"fire"])
effect_defs = Array[ExtResource("2_effect")]([SubResource("Effect_fire_strike")])

[resource]
script = ExtResource("4_skill")
skill_id = &"equipment_phoenix_rebirth_gauntlet_fire_strike"
display_name = "火焰打击"
icon_id = &"equipment_phoenix_rebirth_gauntlet_fire_strike"
description = "装备技能。消耗1 AP，以徒手攻击相邻一个敌人；命中造成1D8 physical_blunt与1D10 fire。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"phoenix_rebirth", &"unarmed", &"melee", &"fire", &"legendary"])
learn_source = &"innate"
combat_profile = SubResource("Combat_fire_strike")
