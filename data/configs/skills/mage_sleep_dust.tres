[resource]
script = ExtResource("5_0acpl")
skill_id = &"mage_sleep_dust"
display_name = "沉眠粉雾"
icon_id = &"mage_sleep_dust"
description = "范围睡眠控制。睡眠会持续跳过目标行动，但目标受到生命伤害或护盾吸收伤害时立即苏醒；苏醒后须完成一次正常行动，才可再次被睡眠。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"illusion", &"control", &"sleep"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "在射程{range}格内选择1格，粉雾覆盖半径1格。范围内敌人进行意志豁免（法术DC修正{dc}）；失败则陷入睡眠{duration}TU：每次轮到其行动时跳过该次行动，且无法反击、格挡或获得闪避加值。睡眠期间免疫再次睡眠；受到实际生命伤害或护盾吸收伤害时立即苏醒（0伤害不会唤醒）。睡眠结束或被移除后获得“清醒”，在完成下一次正常行动前免疫睡眠；被睡眠跳过的行动不消耗“清醒”。不造成伤害，也不会令攻击者获得额外命中或暴击。消耗{ap}AP/{mp}法力/{stamina}体力，冷却{cooldown}TU。"
