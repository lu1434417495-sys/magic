[sub_resource type="Resource" id="Effect_twilight_step_blink"]
script = ExtResource("1_effect")
effect_type = &"forced_move"
forced_move_mode = &"blink"
forced_move_distance = 3

[sub_resource type="Resource" id="Combat_twilight_step"]
script = ExtResource("2_combat")
