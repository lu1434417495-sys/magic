[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_sword_twilight_edge_twilight_step"
display_name = "暮影步"
icon_id = &"weapon_sword_twilight_edge_twilight_step"
description = "装备技能。战斗时间达到70TU后可选，消耗1AP，冷却40TU，闪现至3格内地面格。使用后当前行动轮次内启用暮光切割；白天使用还会让攻击持有者的攻击检定+1直到本行动轮次结束。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"twilight_edge", &"mobility", &"weapon"])
learn_source = &"innate"
combat_profile = SubResource("Combat_twilight_step")
