[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Resource_ef0"]
script = ExtResource("3_effect")
effect_type = &"damage"
min_skill_level = 0
max_skill_level = -1
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_nine_echo_final_hammer"
range_value = 3
weapon_range_policy = &"configured"
area_pattern = &"single"
area_value = 0
ap_cost = 1
stamina_cost = 0
aura_cost = 800
cooldown_tu = 200
attack_roll_bonus = 0
level_overrides = {
	2: {
		"random_chain_attack_count": 4
	},
	4: {
		"random_chain_attack_count": 5
	},
	5: {
		"attack_roll_bonus": 1,
		"random_chain_attack_count": 6
	},
	7: {
		"random_chain_attack_count": 7
	},
	8: {
		"random_chain_attack_count": 8
	},
	10: {
		"random_chain_attack_count": 9
	}
}
mastery_trigger_mode = &"skill_damage_dice_max"
mastery_amount_mode = &"per_target_rank"
projectile_kind = &"current_weapon"
target_selection_mode = &"random_chain"
allow_repeat_target = true
max_hits_per_target = 9
random_chain_attack_count = 3
random_chain_continue_on_miss = true
required_weapon_families = Array[StringName]([&"hammer"])
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_ef0")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_nine_echo_final_hammer"
display_name = "九响终槌"
description = "消耗800斗气，以自身周围3格内的敌人为目标随机挥出多次完整锤击；落空不会中止后续攻击。技能等级提高时攻击次数由3次提升至9次。同一目标在本次施放中第3次命中时踉跄60TU，第6次命中时倒地50TU（倒地免疫生效），第9次命中时震晕30TU并封锁反击、格挡、闪避加成与重击；随后对其追加一次必中、可重击的300%锤击。"
max_level = 10
non_core_max_level = 9
mastery_curve = PackedInt32Array(360, 900, 1980, 3600, 5760, 8600, 12000, 16000, 21000, 26900)
growth_tier = &"ultimate"
attribute_growth_progress = { "strength": 120, "willpower": 120 }
tags = Array[StringName]([&"warrior", &"melee", &"hammer", &"qi", &"aoe", &"finisher"])
combat_profile = SubResource("Resource_combat")
