[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Damage_l0"]
script = ExtResource("1_effect")
effect_type = &"damage"
max_skill_level = 2
damage_tag = &"freeze"
dice_count = 1
dice_sides = 6

[sub_resource type="Resource" id="Damage_l3"]
script = ExtResource("1_effect")
effect_type = &"damage"
min_skill_level = 3
max_skill_level = 6
damage_tag = &"freeze"
dice_count = 2
dice_sides = 6

[sub_resource type="Resource" id="Damage_l7"]
script = ExtResource("1_effect")
effect_type = &"damage"
min_skill_level = 7
damage_tag = &"freeze"
dice_count = 3
dice_sides = 6

[sub_resource type="Resource" id="Slow_l0"]
script = ExtResource("1_effect")
effect_type = &"status"
power = 1
max_skill_level = 5
status_id = &"slow"
display_name = "缓速"
duration_tu = 60

[sub_resource type="Resource" id="Slow_l6"]
script = ExtResource("1_effect")
effect_type = &"status"
power = 1
min_skill_level = 6
status_id = &"slow"
display_name = "缓速"
duration_tu = 80

[sub_resource type="Resource" id="SourceRetreat"]
script = ExtResource("1_effect")
effect_type = &"source_retreat"
source_retreat_distance = 1

[sub_resource type="Resource" id="Combat"]
script = ExtResource("2_combat")
skill_id = &"mage_frost_bolt"
delivery_categories = Array[StringName]([&"spell"])
projectile_kind = &"magical"
range_value = 4
requires_los = true
mp_cost = 25
cooldown_tu = 180
attack_defense_mode = &"touch"
level_overrides = {
1: {
"attack_roll_bonus": 1
},
2: {
"mp_cost": 20
},
4: {
"range_value": 5
},
5: {
"cooldown_tu": 160
}
}
ai_tags = Array[StringName]([&"single_target", &"control"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Damage_l0"), SubResource("Damage_l3"), SubResource("Damage_l7"), SubResource("Slow_l0"), SubResource("Slow_l6"), SubResource("SourceRetreat")])

[resource]
script = ExtResource("3_skill")
skill_id = &"mage_frost_bolt"
display_name = "霜击术"
icon_id = &""
description = "以低耗法力向射程内一名可见敌人发射霜矢，进行一次接触AC法术攻击。命中造成冰冻伤害并施加缓速，使目标移动耗费+1；缓速只刷新持续时间，不叠加。选定目标后，选择一个使你远离目标的正交方向：无论攻击命中、落空或击倒目标，结算后都沿该方向直线后撤最多1格。后撤不消耗移动力，不能转弯或绕路，受阻时停在阻挡前；无法主动移动时不能使用。魔法投射物会被相应屏障阻挡。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"ice", &"control", &"mobility", &"output"])
learn_source = &"book"
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "射程{range}，进行接触AC法术攻击{hit}；命中造成{dmg}冰冻伤害并施加缓速（移动耗费+1，持续{slow_duration}TU），结算后后撤最多1格。消耗1AP/{mp}法力，冷却{cooldown}TU"
level_description_configs = {
