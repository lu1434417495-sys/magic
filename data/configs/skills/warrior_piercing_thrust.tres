[gd_resource type="Resource" script_class="SkillDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatApproachAttackDef.cs" id="2_approach"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("3_effect")
effect_type = &"damage"
power = 0
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Resource_approach"]
script = ExtResource("2_approach")
maximum_path_height_delta_from_origin = 0

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_piercing_thrust"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
min_target_count = 1
max_target_count = 1
max_hits_per_target = 1
range_pattern = &"single"
range_value = 1
weapon_range_policy = &"current_weapon_plus_configured"
requires_los = true
ap_cost = 1
stamina_cost = 24
cooldown_tu = 80
attack_roll_bonus = -1
level_overrides = {
1: {
"attack_roll_bonus": 0
},
2: {
"stamina_cost": 22
},
3: {
"range_value": 2
},
4: {
"cooldown_tu": 70
},
5: {
"attack_roll_bonus": 1,
"stamina_cost": 20
}
}
mastery_trigger_mode = &"weapon_attack_quality"
mastery_amount_mode = &"per_target_rank"
ai_tags = Array[StringName]([&"single_target", &"mobility", &"output"])
required_weapon_type_ids = Array[StringName]([&"spear", &"trident", &"pike"])
allows_natural_weapon = false
approach_attack_profile = SubResource("Resource_approach")
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_damage")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_piercing_thrust"
display_name = "踏步穿刺"
icon_id = &""
description = "仅限装备长矛、三叉戟或长枪使用。选择与你处于同一行或同一列、且在当前武器射程外的一名敌人；沿目标方向直线推进最少格数，直到目标进入当前武器射程，然后进行一次标准武器攻击。推进不消耗移动力，使用后普通移动仍按行动锁定规则处理；即使普通移动力为0或已经锁定，也可以使用，但被定身、束缚等效果限制移动时不能使用。推进不能转弯或绕路，不能穿过单位、不可通行格或屏障；路径上的每个占用格和最终落脚格都必须与起始格处于同一高度。推进途中若被地形、屏障或位置变化效果打断，后续攻击取消，已支付的AP、体力与冷却不返还。攻击使用完整的武器攻击检定、暴击、护甲、护盾、抗性、减伤及装备能力链；未命中时仍停留在推进后的格子。"
level_description_template = "直线推进最多{advance}格至武器射程内并进行1次标准武器攻击；路径全程须与起始格同高；攻击检定{attack}；消耗1AP/{stamina}体力，冷却{cooldown}TU。"
level_description_configs = {
	"0": {
		"advance": "1",
		"attack": "-1",
		"stamina": "24",
		"cooldown": "80"
	},
	"1": {
		"advance": "1",
		"attack": "+0",
		"stamina": "24",
		"cooldown": "80"
	},
	"2": {
		"advance": "1",
		"attack": "+0",
		"stamina": "22",
		"cooldown": "80"
	},
	"3": {
		"advance": "2",
		"attack": "+0",
		"stamina": "22",
		"cooldown": "80"
	},
	"4": {
		"advance": "2",
		"attack": "+0",
		"stamina": "22",
		"cooldown": "70"
	},
	"5": {
		"advance": "2",
		"attack": "+1",
		"stamina": "20",
		"cooldown": "70"
	}
}
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(160, 400, 900, 1600, 2600)
growth_tier = &"intermediate"
attribute_growth_progress = {
"strength": 60,
"perception": 60
}
tags = Array[StringName]([&"warrior", &"melee", &"weapon", &"thrust", &"mobility"])
combat_profile = SubResource("Resource_combat")
