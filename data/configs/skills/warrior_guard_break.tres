[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Resource_weapon_damage"]
script = ExtResource("3_effect")
effect_type = &"damage"
power = 0
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Resource_durability_l0"]
script = ExtResource("3_effect")
effect_type = &"equipment_durability_damage"
power = 12
max_skill_level = 2
effect_target_team_filter = &"enemy"
save_dc_mode = &"static"
save_dc = 12
save_ability = &"strength"
save_tag = &"equipment_disjunction"
require_damage_applied = true
params = {
"max_damaged_items": 1,
"target_slots": Array[StringName]([&"body"])
}

[sub_resource type="Resource" id="Resource_durability_l3"]
script = ExtResource("3_effect")
effect_type = &"equipment_durability_damage"
power = 16
min_skill_level = 3
max_skill_level = 4
effect_target_team_filter = &"enemy"
save_dc_mode = &"static"
save_dc = 12
save_ability = &"strength"
save_tag = &"equipment_disjunction"
require_damage_applied = true
params = {
"max_damaged_items": 1,
"target_slots": Array[StringName]([&"body"])
}

[sub_resource type="Resource" id="Resource_durability_l5"]
script = ExtResource("3_effect")
effect_type = &"equipment_durability_damage"
power = 20
min_skill_level = 5
effect_target_team_filter = &"enemy"
save_dc_mode = &"static"
save_dc = 12
save_ability = &"strength"
save_tag = &"equipment_disjunction"
require_damage_applied = true
params = {
"max_damaged_items": 1,
"target_slots": Array[StringName]([&"body"])
}

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_guard_break"
range_value = 0
ap_cost = 1
stamina_cost = 20
cooldown_tu = 60
level_overrides = {
1: {
"attack_roll_bonus": 1
},
2: {
"stamina_cost": 18
},
4: {
"cooldown_tu": 50
},
5: {
"attack_roll_bonus": 2
}
}
mastery_trigger_mode = &"damage_dealt"
mastery_amount_mode = &"per_target_rank"
allows_natural_weapon = true
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_weapon_damage"), SubResource("Resource_durability_l0"), SubResource("Resource_durability_l3"), SubResource("Resource_durability_l5")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_guard_break"
display_name = "摧甲击"
icon_id = &""
description = "以近战武器或近战型天生武器进行一次标准武器攻击；若目标穿戴身体护甲，命中后迫使其进行力量豁免，失败则损伤护甲耐久，归零时摧毁护甲。"
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(160, 400, 900, 1600, 2600)
growth_tier = &"intermediate"
attribute_growth_progress = {
"strength": 60,
"perception": 60
}
tags = Array[StringName]([&"warrior", &"melee", &"breaker"])
level_description_template = "摧甲击：需要近战武器或近战型天生武器。选择武器射程内一名敌人，进行一次标准武器攻击。命中造成当前武器伤害；若目标穿戴身体护甲，则迫使其进行DC 12力量豁免，装备稀有度会提高该豁免。失败时，身体护甲损失{durability}点耐久。耐久归零时护甲被摧毁并立即失去其全部效果。暴击不会增加耐久损失。未穿戴身体护甲时耐久效果无效。攻击检定{hit}，消耗{ap} AP/{stamina}体力，冷却{cooldown} TU。"
level_description_configs = {
"0": {
"ap": "1",
"cooldown": "60",
"durability": "12",
"hit": "+0",
"stamina": "20"
},
"1": {
"ap": "1",
"cooldown": "60",
"durability": "12",
"hit": "+1",
"stamina": "20"
},
"2": {
"ap": "1",
"cooldown": "60",
"durability": "12",
"hit": "+1",
"stamina": "18"
},
"3": {
"ap": "1",
"cooldown": "60",
"durability": "16",
"hit": "+1",
"stamina": "18"
},
"4": {
"ap": "1",
"cooldown": "50",
"durability": "16",
"hit": "+1",
"stamina": "18"
},
"5": {
"ap": "1",
"cooldown": "50",
"durability": "20",
"hit": "+2",
"stamina": "18"
}
}
combat_profile = SubResource("Resource_combat")
