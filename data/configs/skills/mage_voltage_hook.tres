[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Pull_l0_l3"]
script = ExtResource("1_effect")
effect_type = &"forced_move"
max_skill_level = 3
effect_target_team_filter = &"enemy"
forced_move_mode = &"airborne_pull"
forced_move_distance = 1
forced_move_max_target_body_size = 1
required_target_status_id = &"shocked"
required_target_status_min_stacks = 1

[sub_resource type="Resource" id="Pull_l4"]
script = ExtResource("1_effect")
effect_type = &"forced_move"
min_skill_level = 4
max_skill_level = 4
effect_target_team_filter = &"enemy"
forced_move_mode = &"airborne_pull"
forced_move_distance = 1
forced_move_max_target_body_size = 4
required_target_status_id = &"shocked"
required_target_status_min_stacks = 1

[sub_resource type="Resource" id="Pull_l5_l7"]
script = ExtResource("1_effect")
effect_type = &"forced_move"
min_skill_level = 5
effect_target_team_filter = &"enemy"
forced_move_mode = &"airborne_pull"
forced_move_distance = 2
forced_move_max_target_body_size = 4
required_target_status_id = &"shocked"
required_target_status_min_stacks = 1

[sub_resource type="Resource" id="Consume_shocked"]
script = ExtResource("1_effect")
effect_type = &"erase_status"
effect_target_team_filter = &"enemy"
status_id = &"shocked"
trigger_event = &"forced_move_applied"

[sub_resource type="Resource" id="Apply_staggered"]
script = ExtResource("1_effect")
effect_type = &"status"
power = 1
effect_target_team_filter = &"enemy"
status_id = &"staggered"
duration_tu = 40
trigger_event = &"forced_move_applied"

[sub_resource type="Resource" id="Combat"]
script = ExtResource("2_combat")
skill_id = &"mage_voltage_hook"
delivery_categories = Array[StringName]([&"spell"])
projectile_kind = &"magical"
range_value = 4
requires_los = true
ap_cost = 1
mp_cost = 60
cooldown_tu = 120
attack_resolution_mode = &"direct_effect"
level_overrides = {
1: {
"mp_cost": 55
},
2: {
"range_value": 5
},
3: {
"cooldown_tu": 110
},
4: {},
5: {},
6: {
"mp_cost": 50
},
7: {
"cooldown_tu": 100,
"range_value": 6
}
}
mastery_trigger_mode = &"effect_applied"
ai_tags = Array[StringName]([&"control", &"displacement", &"setup_consumer"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Pull_l0_l3"), SubResource("Pull_l4"), SubResource("Pull_l5_l7"), SubResource("Consume_shocked"), SubResource("Apply_staggered")])

[resource]
script = ExtResource("3_skill")
skill_id = &"mage_voltage_hook"
display_name = "伏电牵引"
icon_id = &""
description = "选择视线与射程内1名处于感电的敌人，再选择一次最终落点。目标无须进行攻击检定、AC判定或豁免，若体型符合当前等级上限且不免疫强制位移，则被升至空中并牵引至比当前位置更接近施法者的合法空格。牵引按正交格距计算，可跨越中间单位占据的格子且不受高低差限制，但不能穿越显式魔法边界；中间格不触发地形，落地时结算一次地形接触。成功位移后消耗感电并施加40TU踉跄。该技能不造成伤害。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"lightning", &"control", &"displacement"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "射程{range}格；牵引感电目标最多{pull}格，允许体型≤{size}。不判AC且无豁免；成功后消耗感电并施加40TU踉跄。消耗{ap}AP/{mp}法力，冷却{cooldown}TU"
level_description_configs = {
"0": {
"ap": "1",
"cooldown": "120",
"mp": "60",
"pull": "1",
"range": "4",
"size": "1"
},
