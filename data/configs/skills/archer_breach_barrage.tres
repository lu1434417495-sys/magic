[gd_resource type="Resource" script_class="SkillDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatDirectionalPiercingDef.cs" id="1_piercing"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="2_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="3_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="4_skill"]

[sub_resource type="Resource" id="Effect_weapon_damage"]
script = ExtResource("2_effect")
effect_type = &"damage"
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Profile_directional_piercing"]
script = ExtResource("1_piercing")
base_damage_percent_curve = PackedInt32Array(200, 200, 220, 240, 260, 280, 290, 300)
successful_hit_decay_percent = 20
minimum_damage_percent = 40
stamina_flat_base = 32
stamina_range_square_coefficient = 1
stamina_strength_square_scale = 100
minimum_stamina_cost = 1
maximum_height_delta = 1

[sub_resource type="Resource" id="Combat_breach_barrage"]
script = ExtResource("3_combat")
skill_id = &"archer_breach_barrage"
projectile_kind = &"current_weapon"
target_mode = &"ground"
target_team_filter = &"any"
target_selection_mode = &"single_unit"
range_value = 0
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 2
stamina_cost = 0
cooldown_tu = 120
attack_roll_bonus = -2
level_overrides = {
	2: {
		"attack_roll_bonus": -1
	},
	4: {
		"attack_roll_bonus": 0
	},
	5: {
		"cooldown_tu": 110
	},
	6: {
		"attack_roll_bonus": 1
	},
	7: {
		"cooldown_tu": 100
	}
}
mastery_trigger_mode = &"weapon_attack_quality"
mastery_amount_mode = &"per_target_rank"
required_weapon_families = Array[StringName]([&"bow"])
directional_piercing_profile = SubResource("Profile_directional_piercing")
effect_defs = Array[ExtResource("2_effect")]([SubResource("Effect_weapon_damage")])

[resource]
script = ExtResource("4_skill")
skill_id = &"archer_breach_barrage"
display_name = "贯阵一矢"
icon_id = &"archer_breach_barrage"
description = "选择相邻的上、下、左或右作为方向，沿当前弓的完整有效射程发射一箭，对路径内所有符合高度通道的存活单位逐个进行标准弓武器攻击；友军与中立单位也会受击，单位不会阻挡箭矢，阻挡视线的墙、关闭的门或边缘屏障会截断路径。以施术者所在格高度为基准：同层单位可受击且不锁定通道；首个遇到的+1或-1层单位自动锁定对应方向，之后只攻击同层及该方向一层内的单位，玩家不能选择高度方向；高度差超过1或位于相反通道的单位会被跳过，且不进行攻击检定、不推进伤害衰减。首个成功命中造成等级对应的武器伤害；每次成功命中使后续目标伤害倍率降低20%，最低40%，未命中不推进衰减。消耗2AP；体力按完整有效弓射程R和力量调整值S计算：B=32+R²，S≥0时为max(1,ceil(B×100/(100+S²)))，S<0时为ceil(B×(100+S²)/100)。"
level_description_template = "造成{damage}弓武器伤害，攻击检定{attack}；每次成功命中使后续目标倍率-20%（最低40%），射程随当前弓，体力按射程与力量动态计算，消耗2AP，冷却{cooldown}TU"
level_description_configs = {
	"0": {
		"damage": "200%",
		"attack": "-2",
		"cooldown": "120"
	},
	"1": {
		"damage": "200%",
		"attack": "-2",
		"cooldown": "120"
	},
	"2": {
		"damage": "220%",
		"attack": "-1",
		"cooldown": "120"
	},
	"3": {
		"damage": "240%",
		"attack": "-1",
		"cooldown": "120"
	},
	"4": {
		"damage": "260%",
		"attack": "无加值",
		"cooldown": "120"
	},
	"5": {
		"damage": "280%",
		"attack": "无加值",
		"cooldown": "110"
	},
	"6": {
		"damage": "290%",
		"attack": "+1",
		"cooldown": "110"
	},
	"7": {
		"damage": "300%",
		"attack": "+1",
		"cooldown": "100"
	}
}
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(300, 750, 1650, 3000, 4800, 7050, 9750)
growth_tier = &"intermediate"
attribute_growth_progress = {
	"strength": 70,
	"agility": 50
}
tags = Array[StringName]([&"archer", &"ranged", &"bow", &"aoe"])
combat_profile = SubResource("Combat_breach_barrage")
