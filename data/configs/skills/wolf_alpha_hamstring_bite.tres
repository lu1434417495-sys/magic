max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
level_description_template = "攻击检定{attack_bonus}，造成天生武器伤害{skill_dice}；命中后使目标移动成本+1，持续{duration}TU。消耗1AP/18体力，冷却60TU。"
