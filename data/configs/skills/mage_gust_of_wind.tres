[resource]
script = ExtResource("3_wind_skill")
skill_id = &"mage_gust_of_wind"
display_name = "强风术"
icon_id = &""
description = "选择施法者正交相邻的地格确定风向，在前方形成锥形强风。范围内敌人进行力量豁免（DC为施法者法术豁免DC）；失败时沿风向推动，成功则不移动。位移不能穿过单位、障碍、屏障或非法地格，受阻时停在最后合法格，并逐格触发地形接触。不进行攻击检定且不造成伤害。1至6级仅影响体型2及以下目标，7级可影响体型4及以下目标；首领身份本身不提供强风免疫。允许对空范围施放，并照常消耗资源及进入冷却。每名实际移动至少1格的敌人每次施放只计一次熟练度：普通5、精英10、首领15；仅成功作用于屏障时固定获得5点，空放、豁免成功、体型或免疫拦截、零位移均不增长熟练度。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"air", &"aoe", &"control", &"displacement"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 100,
"perception": 30,
"willpower": 50
}
level_description_template = "选择相邻格确定风向；前方{area}内，体型不高于{body}的敌人力量豁免失败时沿风向推动{push}格。消耗{ap}AP/{mp}法力，冷却{cooldown}TU"
level_description_configs = {
