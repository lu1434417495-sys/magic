2: {
"mp_cost": 95
},
4: {
"cooldown_tu": 230
},
5: {
"area_value": 3
},
6: {
"cooldown_tu": 220
}
}
mastery_trigger_mode = &"effect_applied"
mastery_amount_mode = &"per_target_rank"
mastery_base_amount = 5
ai_tags = Array[StringName]([&"aoe", &"control", &"displacement"])
