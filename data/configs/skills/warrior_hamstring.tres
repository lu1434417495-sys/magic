power = 2
min_skill_level = 2
max_skill_level = 2
duration_tu = 40

[sub_resource type="Resource" id="Resource_slow_l3_plus"]
script = ExtResource("3_effect")
effect_type = &"status"
status_id = &"slow"
power = 2
min_skill_level = 3
