duration_tu = 60

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_hamstring"
range_value = 1
ap_cost = 1
stamina_cost = 20
cooldown_tu = 80
attack_roll_bonus = 0
level_overrides = {
1: {
"attack_roll_bonus": 1
},
5: {
"cooldown_tu": 60
}
}
mastery_trigger_mode = &"weapon_attack_quality"
mastery_amount_mode = &"per_target_rank"
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_dmg_l0_3"), SubResource("Resource_dmg_l4_plus"), SubResource("Resource_slow_l0_1"), SubResource("Resource_slow_l2"), SubResource("Resource_slow_l3_plus")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_hamstring"
display_name = "断筋斩"
icon_id = &"warrior_tendon_splitter"
description = "使用当前近战武器斩击目标腿部。命中造成武器伤害，并使目标的移动成本增加；随等级提高命中、控制强度与持续时间，核心等级追加技能伤害并缩短冷却。"
level_description_template = "使用当前近战武器攻击目标{{?attack_bonus}}（攻击检定{attack_bonus}）{{/attack_bonus}}，造成武器伤害{{?skill_dice}}并追加{skill_dice}技能骰{{/skill_dice}}；命中后使目标移动成本+{slow_power}，持续{duration}TU。消耗1AP/{stamina}体力，冷却{cooldown}TU，射程随当前近战武器。"
level_description_configs = {
"0": {
"slow_power": "1",
"duration": "40",
"stamina": "20",
"cooldown": "80"
},
"1": {
"attack_bonus": "+1",
"slow_power": "1",
"duration": "40",
"stamina": "20",
"cooldown": "80"
},
"2": {
"attack_bonus": "+1",
"slow_power": "2",
"duration": "40",
"stamina": "20",
"cooldown": "80"
},
"3": {
