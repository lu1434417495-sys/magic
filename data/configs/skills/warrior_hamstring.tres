"skill_dice": "1D4",
"slow_power": "2",
"duration": "60",
"stamina": "20",
"cooldown": "80"
},
"5": {
"attack_bonus": "+1",
"skill_dice": "1D4",
"slow_power": "2",
"duration": "60",
"stamina": "20",
"cooldown": "60"
}
}
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
growth_tier = &"basic"
attribute_growth_progress = { "strength": 30, "agility": 30 }
