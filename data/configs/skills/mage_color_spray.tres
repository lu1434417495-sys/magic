[sub_resource type="Resource" id="Combat"]
script = ExtResource("3_combat")
skill_id = &"mage_color_spray"
delivery_categories = Array[StringName]([&"spell"])
target_mode = &"unit"
target_team_filter = &"enemy"
range_value = 3
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 2
mp_cost = 80
cooldown_tu = 180
level_overrides = {
2: {
"mp_cost": 75
},
3: {
"cooldown_tu": 150
},
6: {
"cooldown_tu": 120,
"mp_cost": 70
},
7: {
"range_value": 4
}
}
ai_tags = Array[StringName]([&"single_target", &"damage", &"control", &"save_dependent"])
target_selection_mode = &"single_unit"
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
effect_defs = Array[ExtResource("1_effect")]([SubResource("Damage_l0"), SubResource("Damage_l1_l2"), SubResource("Damage_l3"), SubResource("Damage_l4"), SubResource("Damage_l5"), SubResource("Damage_l6"), SubResource("Damage_l7")])

[resource]
script = ExtResource("4_skill")
skill_id = &"mage_color_spray"
display_name = "七色炫光"
icon_id = &"mage_color_spray"
description = "选择射程内一个可见敌人，以智力法术DC迫使其进行意志（幻术）豁免。豁免成功时承受一半心灵伤害且不受控制；豁免失败时承受全额心灵伤害，并等概率随机获得一种控制：目眩（下一次实际攻击检定受到-2，4级起为-3，随后消耗）、失衡（系统中的“踉跄”；power=1，持续期间每次自身回合开始损失1AP、攻击处于劣势且无法维持待结算施法）或感电（无法反击，4级起同时无法暴击）。失衡不在4级获得额外强化。三种结果只会出现一种，重复施加刷新同名状态而不叠层。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"illusion", &"output", &"control"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "选择{range}格内一个可见敌人，造成{dmg}心灵伤害；意志（幻术）豁免成功半伤且无控制，失败全伤并等概率随机施加目眩、失衡或感电，持续{duration}TU。{control}消耗{ap}AP/{mp}法力，冷却{cooldown}TU。"
level_description_configs = {
"0": {
"ap": "2",
"cooldown": "180",
