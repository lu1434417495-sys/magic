[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_perfect_rhythm"
display_name = "完美节奏"
description = "启动后持续维持节奏。近战武器每次命中额外获得连击层，并且每10层近战连击使近战武器攻击检定+1。每5TU消耗斗气，维持费用每60TU翻倍；硬控或斗气不足会终止，并在90TU内使攻击检定-3。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(160, 400, 900, 1600, 2600, 3800, 5300)
growth_tier = &"intermediate"
attribute_growth_progress = { "strength": 50, "willpower": 70 }
tags = Array[StringName]([&"warrior", &"melee", &"combo"])
combat_profile = SubResource("Resource_combat")
