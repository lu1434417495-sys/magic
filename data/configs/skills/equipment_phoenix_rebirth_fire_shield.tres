[resource]
script = ExtResource("3_skill")
skill_id = &"equipment_phoenix_rebirth_fire_shield"
display_name = "释放火盾"
icon_id = &"equipment_phoenix_rebirth_fire_shield"
description = "凤凰涅槃板甲的装备技能。消耗2 AP，每个世界日一次；清除板甲全部燃烧层并获得持续60 TU的凤凰火盾（AC+3）。火盾期间每次成功近战命中后，攻击者受到2D6 fire，无豁免。任意燃烧层数均可使用。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"phoenix_rebirth", &"fire", &"defense", &"legendary"])
learn_source = &"innate"
combat_profile = SubResource("Combat_fire_shield")
