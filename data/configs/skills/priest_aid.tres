[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]
[ext_resource type="Script" path="res://scripts/player/progression/ContingencyAutomationDef.cs" id="4_contingency"]

[sub_resource type="Resource" id="Resource_shield_l0_l2"]
script = ExtResource("1_effect")
effect_type = &"shield"
effect_target_team_filter = &"ally"
max_skill_level = 2
duration_tu = 40
dice_count = 1
dice_sides = 8
dice_bonus = 3
shield_family = &"holy_barrier"
shield_attribute_modifier_id = &"willpower_modifier"
shield_roll_per_target = true

[sub_resource type="Resource" id="Resource_shield_l3_l4"]
script = ExtResource("1_effect")
effect_type = &"shield"
effect_target_team_filter = &"ally"
min_skill_level = 3
max_skill_level = 4
duration_tu = 50
dice_count = 1
dice_sides = 8
dice_bonus = 3
shield_family = &"holy_barrier"
shield_attribute_modifier_id = &"willpower_modifier"
shield_roll_per_target = true

[sub_resource type="Resource" id="Resource_shield_l5"]
script = ExtResource("1_effect")
effect_type = &"shield"
effect_target_team_filter = &"ally"
min_skill_level = 5
max_skill_level = 5
duration_tu = 60
dice_count = 1
dice_sides = 8
dice_bonus = 3
shield_family = &"holy_barrier"
shield_attribute_modifier_id = &"willpower_modifier"
shield_roll_per_target = true

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("2_combat")
skill_id = &"priest_aid"
target_mode = &"ground"
target_team_filter = &"ally"
range_value = 0
area_pattern = &"cross"
area_value = 1
ap_cost = 1
mp_cost = 40
stamina_cost = 18
cooldown_tu = 120
mastery_trigger_mode = &"effect_applied"
mastery_amount_mode = &"per_target_rank"
ai_tags = Array[StringName]([&"aoe", &"support", &"shield"])
level_overrides = {
	1: {
		"area_pattern": &"radius",
		"area_value": 1
	},
	2: {
		"stamina_cost": 16
	},
	4: {
		"range_value": 1,
		"stamina_cost": 14
	},
	5: {
		"range_value": 2,
		"cooldown_tu": 100
	}
}
effect_defs = Array[ExtResource("1_effect")]([SubResource("Resource_shield_l0_l2"), SubResource("Resource_shield_l3_l4"), SubResource("Resource_shield_l5")])

[sub_resource type="Resource" id="ContingencyAutomation"]
script = ExtResource("4_contingency")
can_be_stored_in_contingency = true
min_contingency_skill_level = 3
effect_category = &"shield"
allowed_target_resolvers = Array[StringName]([&"owner_centered_area"])
allowed_parameter_bindings = {}

[resource]
script = ExtResource("3_skill")
skill_id = &"priest_aid"
display_name = "援助术"
icon_id = &"priest_aid"
description = "2环神术。选择自身所在格（4级起可选择近处地格），使范围内每名存活友军分别获得1D8+3+施法者意志调整值的神圣护盾。每个目标独立投骰；同族护盾取较高数值并延长持续时间，不叠加。"
level_description_template = "选择{range}内地格，使{area}内每名存活友军分别获得1D8+3+意志调整值的神圣护盾，持续{duration}TU；消耗1AP/{mp}MP/{stamina}体力，冷却{cooldown}TU"
level_description_configs = {
	"0": { "range": "自身", "area": "十字相邻1格", "duration": "40", "mp": "40", "stamina": "18", "cooldown": "120" },
	"1": { "range": "自身", "area": "3×3范围", "duration": "40", "mp": "40", "stamina": "18", "cooldown": "120" },
	"2": { "range": "自身", "area": "3×3范围", "duration": "40", "mp": "40", "stamina": "16", "cooldown": "120" },
	"3": { "range": "自身", "area": "3×3范围", "duration": "50", "mp": "40", "stamina": "16", "cooldown": "120" },
	"4": { "range": "1格", "area": "3×3范围", "duration": "50", "mp": "40", "stamina": "14", "cooldown": "120" },
	"5": { "range": "2格", "area": "3×3范围", "duration": "60", "mp": "40", "stamina": "14", "cooldown": "100" }
}
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(150, 375, 825, 1500, 2400)
growth_tier = &"intermediate"
attribute_growth_progress = { "willpower": 120 }
tags = Array[StringName]([&"priest", &"holy", &"support", &"shield", &"aoe"])
combat_profile = SubResource("Resource_combat")
contingency_automation_profile = SubResource("ContingencyAutomation")
