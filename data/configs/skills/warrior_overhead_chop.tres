[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Resource_ef0"]
script = ExtResource("3_effect")
effect_type = &"damage"
min_skill_level = 0
max_skill_level = 2
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true
dice_count = 1
dice_sides = 8
weapon_dice_multiplier = 1
bonus_condition = &"target_hard_controlled"
bonus_damage_dice_count = 1
bonus_damage_dice_sides = 6
bonus_damage_separate_event = true

[sub_resource type="Resource" id="Resource_ef1"]
script = ExtResource("3_effect")
effect_type = &"damage"
min_skill_level = 3
max_skill_level = 4
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true
dice_count = 1
dice_sides = 8
weapon_dice_multiplier = 2
bonus_condition = &"target_hard_controlled"
bonus_damage_dice_count = 1
bonus_damage_dice_sides = 6
bonus_damage_separate_event = true

[sub_resource type="Resource" id="Resource_ef2"]
script = ExtResource("3_effect")
effect_type = &"damage"
min_skill_level = 5
max_skill_level = -1
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true
dice_count = 2
dice_sides = 8
weapon_dice_multiplier = 2
bonus_condition = &"target_hard_controlled"
bonus_damage_dice_count = 1
bonus_damage_dice_sides = 6
bonus_damage_separate_event = true

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_overhead_chop"
range_value = 1
weapon_range_policy = &"configured"
ap_cost = 1
stamina_cost = 45
cooldown_tu = 60
attack_roll_bonus = 1
level_overrides = {
	3: {
		"stamina_cost": 40,
		"cooldown_tu": 45
	},
	5: {
		"stamina_cost": 35,
		"cooldown_tu": 30
	}
}
mastery_trigger_mode = &"skill_damage_dice_max"
mastery_amount_mode = &"per_target_rank"
required_weapon_type_ids = Array[StringName]([&"greatsword"])
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_ef0"), SubResource("Resource_ef1"), SubResource("Resource_ef2")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_overhead_chop"
display_name = "重剑斩"
description = "以双手大剑重劈相邻目标。技能等级提高时复制更多基础物理武器骰；目标处于倒地、震慑、麻痹、冰冻或石化时，独立追加1d6物理伤害，该追加伤害可重击。武器的非物理附伤不会被复制。"
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
growth_tier = &"basic"
attribute_growth_progress = { "constitution": 20, "strength": 40 }
tags = Array[StringName]([&"warrior", &"melee", &"greatsword", &"output"])
combat_profile = SubResource("Resource_combat")
