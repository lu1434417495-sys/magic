[resource]
script = ExtResource("5_jl5r8")
skill_id = &"mage_bone_chill"
display_name = "骨寒术"
icon_id = &""
description = "选择射程内一个可见的存活敌人（亡灵与构装除外），发射寒冷的负能量。命中造成负能量伤害并施加寒蚀；寒蚀期间，目标获得的生命治疗至多为正常值的50%。寒蚀只新增或刷新自身，不会延长其他减疗效果。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"necromancy", &"output", &"debuff"])
growth_tier = &"advanced"
