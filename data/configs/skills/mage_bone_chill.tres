"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "仅对非亡灵、非构装的存活敌人有效；射程{range}，接触攻击检定{hit}，命中造成{dmg}负能量伤害并施加寒蚀，使其获得的生命治疗至多为正常值的50%，持续{duration}TU。消耗{ap}AP/{mp}法力，冷却{cooldown}TU"
