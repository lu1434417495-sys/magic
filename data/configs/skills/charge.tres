[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatCastVariantDef.cs" id="2_charge_option"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_charge_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_charge_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_charge_skill"]

[sub_resource type="Resource" id="Resource_charge_effect"]
script = ExtResource("3_charge_effect")
effect_type = &"charge"
charge_trap_immunity_min_skill_level = 7

[sub_resource type="Resource" id="Resource_charge_line"]
script = ExtResource("2_charge_option")
variant_id = &"charge_line"
display_name = "直线冲锋"
description = "选择同一行或同一列的目标格，沿该方向逐格冲锋。"
effect_defs = Array[ExtResource("3_charge_effect")]([SubResource("Resource_charge_effect")])

[sub_resource type="Resource" id="Resource_charge_combat"]
script = ExtResource("4_charge_combat")
skill_id = &"charge"
target_mode = &"ground"
target_team_filter = &"any"
range_value = 3
ap_cost = 1
stamina_cost = 50
cooldown_tu = 50
level_overrides = {
1: {
"range_value": 4
},
2: {
"stamina_cost": 35
},
3: {
"range_value": 5
},
4: {
"stamina_cost": 30
},
5: {
"range_value": 6
},
6: {
"stamina_cost": 25
},
7: {
"range_value": 7
}
}
cast_variants = Array[ExtResource("2_charge_option")]([SubResource("Resource_charge_line")])

[resource]
script = ExtResource("5_charge_skill")
skill_id = &"charge"
display_name = "冲锋"
icon_id = &"charge"
description = "朝四个正交方向发起位移并推挤沿途单位。技能本身不造成伤害；推挤可能触发地形碰撞或坠落伤害。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600, 2350, 3250)
level_description_template = "直线冲锋{range_value}格，消耗{ap_cost}AP/{stamina_cost}体力，冷却{cooldown_tu}TU。技能本身不造成伤害；推挤可能触发地形碰撞或坠落伤害。{{?trap_immunity}}免疫陷阱造成的冲锋中断。{{/trap_immunity}}"
level_description_configs = {
"7": {
"trap_immunity": "true"
}
}
growth_tier = &"intermediate"
attribute_requirements = {
"agility": 14,
"strength": 12
}
attribute_growth_progress = {
"agility": 100,
"strength": 20
}
tags = Array[StringName]([&"melee", &"mobility", &"charge"])
mastery_sources = Array[StringName]([&"training", &"battle"])
combat_profile = SubResource("Resource_charge_combat")
