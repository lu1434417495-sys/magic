[gd_resource type="Resource" script_class="SkillDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_weapon_damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
power = 0
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Effect_repel"]
script = ExtResource("1_effect")
effect_type = &"forced_move"
forced_move_mode = &"knockback"
forced_move_distance = 1
trigger_event = &"attack_hit"

[sub_resource type="Resource" id="Combat_repel_arrow"]
script = ExtResource("2_combat")
skill_id = &"archer_repel_arrow"
projectile_kind = &"current_weapon"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 0
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
stamina_cost = 36
cooldown_tu = 90
level_overrides = {
	2: {
		"stamina_cost": 34
	},
	3: {
		"attack_roll_bonus": 1
	},
	4: {
		"cooldown_tu": 80
	},
	5: {
		"attack_roll_bonus": 2
	},
}
mastery_trigger_mode = &"weapon_attack_quality"
mastery_amount_mode = &"per_target_rank"
ai_tags = Array[StringName]([&"single_target", &"control", &"displacement"])
required_weapon_families = Array[StringName]([&"bow"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_weapon_damage"), SubResource("Effect_repel")])

[resource]
script = ExtResource("3_skill")
skill_id = &"archer_repel_arrow"
display_name = "震退箭"
icon_id = &"archer_repel_arrow"
description = "使用弓进行一次标准武器攻击；命中后将目标沿射击方向击退1格。击退受地形、占位和强制位移免疫限制，无法移动时不追加伤害。"
level_description_template = "造成一次标准弓武器攻击伤害；命中后沿射击方向击退1格，射程随弓，消耗1AP/{stamina}体力，冷却{cooldown}TU{accuracy}"
level_description_configs = {
	"0": {
		"stamina": "36",
		"cooldown": "90",
		"accuracy": ""
	},
	"1": {
		"stamina": "36",
		"cooldown": "90",
		"accuracy": ""
	},
	"2": {
		"stamina": "34",
		"cooldown": "90",
		"accuracy": ""
	},
	"3": {
		"stamina": "34",
		"cooldown": "90",
		"accuracy": "，攻击检定+1"
	},
	"4": {
		"stamina": "34",
		"cooldown": "80",
		"accuracy": "，攻击检定+1"
	},
	"5": {
		"stamina": "34",
		"cooldown": "80",
		"accuracy": "，攻击检定+2"
	},
}
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
growth_tier = &"basic"
attribute_growth_progress = {
	"agility": 40,
	"perception": 20,
}
tags = Array[StringName]([&"archer", &"ranged", &"bow", &"control", &"displacement"])
combat_profile = SubResource("Combat_repel_arrow")
