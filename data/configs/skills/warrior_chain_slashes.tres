[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_chain_slashes"
range_value = 1
ap_cost = 1
stamina_cost = 30
cooldown_tu = 10
attack_roll_bonus = 0
level_overrides = {
	3: {
		"stamina_cost": 24
	},
	5: {
		"attack_roll_bonus": 1
	},
	6: {
		"stamina_cost": 20
	}
}
mastery_trigger_mode = &"skill_damage_dice_max"
mastery_amount_mode = &"per_target_rank"
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_ef0"), SubResource("Resource_ef1"), SubResource("Resource_ef2"), SubResource("Resource_repeat")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_chain_slashes"
display_name = "三连斩"
description = "对同一目标连续发动三次近战攻击，每段独立结算；每段命中获得1层近战连击。"
level_description_template = "连续攻击3次，每段追加{skill_dice}技能骰。{{?attack}}攻击检定{attack}，{{/attack}}体力消耗{stamina}。"
