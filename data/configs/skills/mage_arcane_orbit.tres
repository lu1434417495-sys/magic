[sub_resource type="Resource" id="Resource_ranged_weapon_reaction"]
script = ExtResource("2_reaction")
readiness_status_id = &"arcane_orbit_ready"
trigger_weapon_families = Array[StringName]([&"bow", &"crossbow"])
damage_tag = &"force"
attack_defense_mode = &"touch"
attack_roll_bonus_by_skill_level = PackedInt32Array(0, 1, 1, 1, 2, 2, 2, 3)
consume_status_stacks = 1
trigger_on_hit = true
trigger_on_miss = true
allow_critical = false

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("3_combat")
skill_id = &"mage_arcane_orbit"
delivery_categories = Array[StringName]([&"spell"])
target_mode = &"unit"
target_team_filter = &"self"
target_selection_mode = &"self"
selection_order_mode = &"stable"
range_value = 0
area_pattern = &"self"
ap_cost = 1
mp_cost = 100
cooldown_tu = 240
attack_resolution_mode = &"direct_effect"
attack_defense_mode = &"touch"
mastery_trigger_mode = &"effect_applied"
mastery_amount_mode = &"per_target_rank"
level_overrides = {
3: {
"cooldown_tu": 210
},
5: {
"mp_cost": 90
},
7: {
"cooldown_tu": 180
}
}
ranged_weapon_reaction_profile = SubResource("Resource_ranged_weapon_reaction")
effect_defs = Array[ExtResource("1_effect")]([SubResource("Resource_orbit_l0_l1"), SubResource("Resource_orbit_l2"), SubResource("Resource_orbit_l3_l5"), SubResource("Resource_orbit_l6"), SubResource("Resource_orbit_l7")])

[resource]
script = ExtResource("4_skill")
skill_id = &"mage_arcane_orbit"
display_name = "轨道法珠"
icon_id = &""
description = "在自身周围形成轨道法珠。持续期间，每当你成为弓或弩的直接远程武器攻击目标，待该次独立攻击检定及其全部效果结算完毕后，无论原攻击命中或未命中，均消耗1枚法珠对攻击者进行一次独立的接触攻击检定；命中时，复制该次攻击已快照的主武器骰及其W倍率并转为力场伤害。法珠不复制属性与固定加值、暴击额外骰、毒素、装备能力或其他伤害段，且本次反击不能暴击；反击沿用已成立的原弹道，不重新检查距离或视线。每次独立攻击检定最多触发并消耗1枚。重复施放不会叠加第二组法珠，而是将现有法珠补满至当前等级上限并刷新持续时间。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"arcane", &"reaction", &"defense", &"anti_ranged"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 90,
"perception": 20,
"willpower": 70
}
level_description_template = "形成{orbs}枚法珠，持续{duration}TU；每次受到弓/弩远程武器攻击检定后消耗1枚，以{hit}进行不可暴击的独立接触攻击，命中造成该次攻击主武器骰W倍率的力场伤害。重施补满并刷新。消耗1AP/{mp}法力，冷却{cooldown}TU"
level_description_configs = {
"0": {
"cooldown": "240",
"duration": "60",
"hit": "+0",
"mp": "100",
"orbs": "2"
},
"1": {
