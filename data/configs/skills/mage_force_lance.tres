[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSequentialLineHitDef.cs" id="2_sequence"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="3_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="4_skill"]

[sub_resource type="Resource" id="DamageLevel0"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_categories = Array[StringName]([&"force_effect"])
max_skill_level = 1
damage_tag = &"force"
dice_count = 2
dice_sides = 8

[sub_resource type="Resource" id="DamageLevel2"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_categories = Array[StringName]([&"force_effect"])
min_skill_level = 2
max_skill_level = 3
damage_tag = &"force"
dice_count = 3
dice_sides = 8

[sub_resource type="Resource" id="DamageLevel4"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_categories = Array[StringName]([&"force_effect"])
min_skill_level = 4
max_skill_level = 5
damage_tag = &"force"
dice_count = 4
dice_sides = 8

[sub_resource type="Resource" id="DamageLevel6"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_categories = Array[StringName]([&"force_effect"])
min_skill_level = 6
max_skill_level = 6
damage_tag = &"force"
dice_count = 5
dice_sides = 8

[sub_resource type="Resource" id="DamageLevel7"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_categories = Array[StringName]([&"force_effect"])
min_skill_level = 7
damage_tag = &"force"
dice_count = 6
dice_sides = 8

[sub_resource type="Resource" id="SequentialLineHit"]
script = ExtResource("2_sequence")
minimum_primary_distance_curve = PackedInt32Array(2, 2, 2, 2, 2, 2, 1, 1)
continuation_range_curve = PackedInt32Array(2, 2, 2, 3, 3, 3, 3, 3)
follow_up_attack_penalty_curve = PackedInt32Array(2, 2, 2, 2, 2, 1, 1, 1)

[sub_resource type="Resource" id="CombatProfile"]
script = ExtResource("3_combat")
skill_id = &"mage_force_lance"
target_mode = &"unit"
target_team_filter = &"enemy"
range_pattern = &"single"
range_value = 5
weapon_range_policy = &"configured"
requires_los = true
ap_cost = 1
mp_cost = 360
cooldown_tu = 180
sequential_line_hit_profile = SubResource("SequentialLineHit")
attack_resolution_mode = &"auto"
attack_defense_mode = &"touch"
delivery_categories = Array[StringName]([&"spell"])
projectile_kind = &"magical"
target_selection_mode = &"single_unit"
min_target_count = 1
max_target_count = 2
max_hits_per_target = 1
level_overrides = {
1: {
"attack_roll_bonus": 1
},
2: {
"mp_cost": 330
},
4: {
"cooldown_tu": 150
},
5: {
"range_value": 6
},
6: {
"mp_cost": 300
},
7: {
"attack_roll_bonus": 2,
"max_target_count": 3
}
}
effect_defs = Array[ExtResource("1_effect")]([SubResource("DamageLevel0"), SubResource("DamageLevel2"), SubResource("DamageLevel4"), SubResource("DamageLevel6"), SubResource("DamageLevel7")])

[resource]
script = ExtResource("4_skill")
skill_id = &"mage_force_lance"
display_name = "力场矛"
icon_id = &"mage_force_lance"
description = "向正交方向上的首个敌人投射力场长矛，逐段进行接触AC法术攻击。每段命中后沿原方向追击续行距离内的下一个敌人；任一段落空，或遇到友军、非敌对单位、阻挡视线的边、墙体或屏障时停止。每段独立暴击，并正常经过护盾、力场抗性与减伤。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"arcane", &"force", &"output"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "正交首敌，射程{min_range}–{range}，接触AC攻击{hit}；命中造成{dmg}力场伤害。命中后续行{continue_range}格，后续每段累计{followup}命中，最多{targets}个目标；落空或遇阻停止。消耗{ap}AP/{mp}法力，冷却{cooldown}TU"
level_description_configs = {
