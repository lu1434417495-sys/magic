[gd_resource type="Resource" script_class="SkillDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_oath_target"]
script = ExtResource("1_effect")
effect_type = &"status"
effect_target_team_filter = &"enemy"
status_id = &"oathscar_oath_target"
duration_tu = 10000
power = 1
stack_behavior = &"refresh"
stack_limit = 1

[sub_resource type="Resource" id="Combat_bind_oath"]
script = ExtResource("2_combat")
skill_id = &"weapon_sword_oathscar_bind_oath"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 6
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
attack_resolution_mode = &"direct_effect"
cooldown_tu = 0
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"equipment", &"weapon", &"radiant"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_oath_target")])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_sword_oathscar_bind_oath"
display_name = "誓约绑定"
icon_id = &"weapon_sword_oathscar_bind_oath"
description = "装备技能。消耗1AP，指定视野内一个敌人成为誓言目标；同一持有者同一把誓约之痕只能维持一个誓言目标。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"oathscar", &"oath", &"weapon", &"radiant"])
learn_source = &"innate"
combat_profile = SubResource("Combat_bind_oath")
