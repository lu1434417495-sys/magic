[resource]
script = ExtResource("3_skill")
skill_id = &"wolf_alpha_cull_the_weak"
display_name = "弱者扑杀"
icon_id = &"wolf_alpha_cull_the_weak"
description = "扑咬单个敌人。目标在攻击前生命值不高于50%时，命中后追加低血伤害；它不是处决，也不造成百分比伤害。"
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
level_description_template = "攻击检定+1，造成天生武器伤害并追加{base_dice}；若目标攻击前生命值不高于50%，再追加{low_hp_dice}。消耗2AP/24体力，冷却80TU。"
level_description_configs = {
"1": {
"base_dice": "1D6",
"low_hp_dice": "1D6"
},
"2": {
"base_dice": "1D6",
"low_hp_dice": "1D8"
},
"3": {
"base_dice": "1D6",
"low_hp_dice": "2D6"
},
"4": {
"base_dice": "1D8",
"low_hp_dice": "2D8"
},
"5": {
"base_dice": "2D6",
"low_hp_dice": "2D8"
}
}
learn_source = &"internal"
tags = Array[StringName]([&"internal", &"enemy", &"wolf", &"melee", &"finisher"])
combat_profile = SubResource("Combat")
