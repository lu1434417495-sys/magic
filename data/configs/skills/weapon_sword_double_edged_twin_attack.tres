[gd_resource type="Resource" script_class="SkillDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_twin_attack_damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_target_team_filter = &"enemy"
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true
dice_count = 3
dice_sides = 6

[sub_resource type="Resource" id="Combat_twin_attack"]
script = ExtResource("2_combat")
skill_id = &"weapon_sword_double_edged_twin_attack"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"multi_unit"
range_pattern = &"single"
range_value = 1
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
stamina_cost = 24
attack_resolution_mode = &"direct_effect"
cooldown_tu = 0
min_target_count = 2
max_target_count = 2
allow_repeat_target = false
selection_order_mode = &"stable"
required_weapon_families = Array[StringName]([&"sword"])
required_weapon_type_ids = Array[StringName]([&"longsword"])
delivery_categories = Array[StringName]([&"equipment", &"double_edged", &"weapon", &"melee"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_twin_attack_damage")])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_sword_double_edged_twin_attack"
display_name = "双刃攻击"
icon_id = &"weapon_sword_double_edged_twin_attack"
description = "装备技能。1AP、24体力；选择武器范围内两个不同敌人，分别进行武器攻击，命中造成武器伤害+3D6 physical_slash；若至少造成一次HP伤害，行动后自身受到固定8HP反伤；若本次击杀两个目标，反伤后治疗2D8HP；同一行动回合限用1次。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"double_edged", &"weapon", &"melee"])
learn_source = &"innate"
combat_profile = SubResource("Combat_twin_attack")
