[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("2_combat")
skill_id = &"archer_flash_whistle"
projectile_kind = &"nonmagical"
target_mode = &"ground"
target_team_filter = &"enemy"
range_value = 0
requires_los = true
area_pattern = &"radius"
area_value = 1
ap_cost = 1
stamina_cost = 30
cooldown_tu = 100
required_weapon_families = Array[StringName]([&"bow"])
allows_natural_weapon = false
mastery_trigger_mode = &"status_applied"
mastery_amount_mode = &"per_target_rank"
ai_tags = Array[StringName]([&"aoe", &"control", &"debuff"])
level_overrides = {
	2: {
		"stamina_cost": 28
	},
	4: {
		"cooldown_tu": 90
	},
	5: {
		"stamina_cost": 26,
		"cooldown_tu": 80
	}
}
effect_defs = Array[ExtResource("1_effect")]([SubResource("Resource_dazzled_l0_l2"), SubResource("Resource_dazzled_l3_l4"), SubResource("Resource_dazzled_l5")])

[resource]
script = ExtResource("3_skill")
skill_id = &"archer_flash_whistle"
display_name = "炫目鸣镝"
icon_id = &""
description = "向弓射程内的地格发射一支不造成伤害的鸣镝，爆响使半径1格内的敌人炫目：攻击检定-2且无法反击。炫目不影响移动、施法、AP、格挡或闪避加值，不视为致盲；重复施加只刷新持续时间，不叠加效果。"
level_description_template = "不造成伤害；使半径1格内敌人炫目{duration}TU（攻击检定-2且无法反击），射程随弓，消耗1AP/{stamina}体力，冷却{cooldown}TU"
level_description_configs = {
	"0": { "duration": "30", "stamina": "30", "cooldown": "100" },
	"1": { "duration": "30", "stamina": "30", "cooldown": "100" },
	"2": { "duration": "30", "stamina": "28", "cooldown": "100" },
	"3": { "duration": "35", "stamina": "28", "cooldown": "100" },
	"4": { "duration": "35", "stamina": "28", "cooldown": "90" },
	"5": { "duration": "40", "stamina": "26", "cooldown": "80" }
}
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
growth_tier = &"basic"
attribute_growth_progress = {
	"perception": 40,
	"agility": 20
}
tags = Array[StringName]([&"archer", &"ranged", &"bow", &"control", &"aoe"])
combat_profile = SubResource("Resource_combat")
