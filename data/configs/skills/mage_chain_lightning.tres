[sub_resource type="Resource" id="Combat"]
script = ExtResource("2_combat")
skill_id = &"mage_chain_lightning"
delivery_categories = Array[StringName]([&"spell"])
projectile_kind = &"magical"
target_team_filter = &"enemy"
range_value = 5
ap_cost = 2
mp_cost = 180
stamina_cost = 0
cooldown_tu = 160
level_overrides = {
2: {
"mp_cost": 160
},
4: {
"cooldown_tu": 100
}
}
target_selection_mode = &"single_unit"
spell_fate_mode = &"control_roll"
spell_critical_mode = &"mp_refund"
spell_critical_mp_refund_percent = 50
fumble_protection_curve = PackedInt32Array(0, 0, 0, 1, 1, 2, 2, 3)
fumble_protection_extra_mp_percent = 100
ai_tags = Array[StringName]([&"chain", &"aoe", &"setup"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Damage_l0"), SubResource("Damage_l1"), SubResource("Damage_l3"), SubResource("Damage_l6"), SubResource("Damage_l7"), SubResource("Chain_l0"), SubResource("Chain_l1"), SubResource("Chain_l5"), SubResource("Chain_l6"), SubResource("Chain_l7")])

[resource]
script = ExtResource("3_skill")
skill_id = &"mage_chain_lightning"
display_name = "链式闪击"
icon_id = &""
description = "锁定射程5内一名敌人，以其为主目标释放链式雷电；即使没有可连锁目标也可以施放。雷电从每个已命中的单位继续跳向跳距内最近、尚未命中的存活单位，不分敌我且可能跳回施法者，不设目标数量上限，直到没有合法目标。单位在施法前已感电或站在湿地上时，从该单位发出的跳跃使用导电跳距；本次施法新施加的感电不会延长同一次连锁。每个目标分别进行敏捷豁免，技能成长会额外提高豁免DC；失败承受全额雷电伤害并感电，成功承受一半伤害且不感电。任一跳被魔法屏障阻挡时，剩余连锁停止。受保护的大失败额外消耗至多等于本次已支付法力的剩余法力、跳过全部效果且不返还已支付的AP、法力和冷却；保护次数耗尽后的大失败触发反噬，使每跳距离+1。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"lightning", &"aoe", &"output", &"control"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "射程5，锁定1名敌人（没有可连锁目标也可施放）；雷电逐跳选择最近的未命中存活单位，不设目标数量上限，基础/导电跳距为{base_hop}/{conductive_hop}格。每个目标敏捷豁免（{save_dc_text}）：失败承受{dmg}雷电伤害并感电{shock_duration}TU，成功承受一半伤害且不感电。连锁不分敌我且可能命中施法者；屏障阻断任一跳时停止剩余连锁。{fumble_text}消耗{ap}AP/{mp}法力，冷却{cooldown}TU"
