[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Resource_stamina"]
script = ExtResource("3_effect")
effect_type = &"stamina_restore"
dice_count = 8
dice_sides_base = 4
dice_sides_per_constitution_mod = 2
dice_sides_per_willpower_mod = 1

[sub_resource type="Resource" id="Resource_erase"]
script = ExtResource("3_effect")
effect_type = &"erase_status"
status_id = &"slow"

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_guard_rotation"
target_mode = &"ground"
target_team_filter = &"ally"
range_value = 0
area_pattern = &"radius"
area_value = 2
ap_cost = 1
stamina_cost = 18
cooldown_tu = 160
mastery_trigger_mode = &"effect_applied"
mastery_amount_mode = &"per_target_rank"
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_stamina"), SubResource("Resource_erase")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_guard_rotation"
display_name = "守备轮换"
icon_id = &"warrior_guard_rotation"
description = "为周围友军恢复体力，清除迟缓。"
max_level = 3
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550)
growth_tier = &"basic"
attribute_growth_progress = { "constitution": 30, "willpower": 30 }
tags = Array[StringName]([&"warrior", &"melee", &"team", &"recovery"])
combat_profile = SubResource("Resource_combat")
