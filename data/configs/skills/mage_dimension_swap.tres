[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="PositionSwapEffect"]
script = ExtResource("1_effect")
effect_type = &"position_swap"
effect_target_team_filter = &"any"
exclude_source = true
save_dc_mode = &"caster_spell"
save_dc_source_ability = &"intelligence"
save_ability = &"willpower"
save_tag = &"magic"

[sub_resource type="Resource" id="DimensionSwapProfile"]
script = ExtResource("2_profile")
skill_id = &"mage_dimension_swap"
target_mode = &"unit"
target_team_filter = &"any"
target_selection_mode = &"single_unit"
selection_order_mode = &"manual"
delivery_categories = Array[StringName]([&"spell", &"location"])
range_pattern = &"fixed"
range_value = 3
requires_los = true
ap_cost = 2
mp_cost = 80
stamina_cost = 16
cooldown_tu = 180
level_overrides = {
1: {
"stamina_cost": 14
},
2: {
"range_value": 4
},
3: {
"cooldown_tu": 150
},
4: {
"mp_cost": 70
},
5: {
"range_value": 5
},
6: {
"stamina_cost": 12
},
7: {
"cooldown_tu": 120
}
}
mastery_trigger_mode = &"effect_applied"
mastery_amount_mode = &"per_target_rank"
mastery_base_amount = 10
mastery_low_hp_bonus_multiplier = 1
effect_defs = Array[ExtResource("1_effect")]([SubResource("PositionSwapEffect")])

[resource]
script = ExtResource("3_skill")
skill_id = &"mage_dimension_swap"
display_name = "移形换位"
icon_id = &"mage_dimension_swap"
description = "选择射程内一个你能看见的其他存活单位，与其交换位置。友军无需豁免；敌人必须进行意志豁免，失败时才会交换。双方必须都能合法占据对方原位置，且交换不能穿越阻止任一方的屏障。交换不经过中间地格，不触发路径地形效果，也不造成伤害。消耗2AP/80法力/16体力，冷却180TU。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(100, 250, 500, 800, 1200, 1700, 2300)
tags = Array[StringName]([&"mage", &"magic", &"support", &"control", &"mobility"])
growth_tier = &"advanced"
attribute_growth_progress = {
"agility": 50,
"intelligence": 90,
"willpower": 40
}
level_description_template = "选择射程内一个你能看见的其他存活单位，与其交换位置。友军无需豁免；敌人必须进行意志豁免，失败时才会交换。双方必须都能合法占据对方原位置，且交换不能穿越阻止任一方的屏障。交换不经过中间地格，不触发路径地形效果，也不造成伤害。消耗{ap}AP/{mp}法力/{stamina}体力，冷却{cooldown}TU。"
level_description_configs = {
"0": {
"ap": "2",
"cooldown": "180",
"mp": "80",
"range": "3",
"stamina": "16"
},
"1": {
