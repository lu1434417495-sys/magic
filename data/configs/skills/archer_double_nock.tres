[gd_resource type="Resource" script_class="SkillDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_weapon_damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Effect_double_nock_repeat"]
script = ExtResource("1_effect")
effect_type = &"fixed_repeat_attack"
stop_on_miss = true
stop_on_target_down = true
fixed_attack_count = 2
follow_up_damage_multiplier_percent = 200
follow_up_attack_roll_bonus_curve = PackedInt32Array(0, 0, 1, 1, 2, 2)

[sub_resource type="Resource" id="Combat_double_nock"]
script = ExtResource("2_combat")
skill_id = &"archer_double_nock"
projectile_kind = &"current_weapon"
range_value = 0
ap_cost = 1
stamina_cost = 24
cooldown_tu = 60
attack_roll_bonus = 0
level_overrides = {
	3: {
		"attack_roll_bonus": 1
	},
	5: {
		"attack_roll_bonus": 2
	}
}
mastery_trigger_mode = &"weapon_attack_quality"
mastery_amount_mode = &"per_target_rank"
ai_tags = Array[StringName]([&"focus_fire"])
required_weapon_families = Array[StringName]([&"bow"])
allows_natural_weapon = false
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_weapon_damage"), SubResource("Effect_double_nock_repeat")])

[resource]
script = ExtResource("3_skill")
skill_id = &"archer_double_nock"
display_name = "双弦连射"
icon_id = &"archer_double_nock"
description = "以同一目标为焦点连续射击。第一箭进行标准弓武器攻击；仅当第一箭命中且目标仍存活时发射第二箭，第二箭进行独立的标准弓武器攻击并造成200%武器伤害。两箭各自进行攻击检定、暴击判定，并分别经过护甲与减伤链。"
level_description_template = "第一箭命中且目标存活才发射第二箭；第一箭造成100%弓武器伤害，攻击检定{first_attack}；第二箭造成200%弓武器伤害，攻击检定{second_attack}。射程随当前弓，消耗1AP/24体力，冷却60TU"
level_description_configs = {
	"0": {
		"first_attack": "无加值",
		"second_attack": "无加值"
	},
	"1": {
		"first_attack": "无加值",
		"second_attack": "无加值"
	},
	"2": {
		"first_attack": "无加值",
		"second_attack": "+1"
	},
	"3": {
		"first_attack": "+1",
		"second_attack": "+2"
	},
	"4": {
		"first_attack": "+1",
		"second_attack": "+3"
	},
	"5": {
		"first_attack": "+2",
		"second_attack": "+4"
	}
}
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
growth_tier = &"basic"
attribute_growth_progress = {
	"agility": 40,
	"perception": 20
}
learn_source = &"book"
tags = Array[StringName]([&"archer", &"ranged", &"bow", &"output", &"focus_fire"])
combat_profile = SubResource("Combat_double_nock")
