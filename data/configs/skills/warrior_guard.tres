[resource]
script = ExtResource("5_omw41")
skill_id = &"warrior_guard"
display_name = "格挡"
icon_id = &"warrior_guard"
description = "进入短暂的格挡姿态。姿态期间，每次受到物理伤害时固定减少1至3点伤害，最低仍受到1点伤害；4级前移动每格额外消耗1点移动力，4级起解除该惩罚。对非物理伤害无效。"
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(300, 750, 1650, 3000, 4800)
growth_tier = &"basic"
