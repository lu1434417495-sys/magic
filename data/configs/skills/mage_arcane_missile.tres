[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_categories = Array[StringName]([&"force_effect"])
damage_tag = &"force"
max_skill_level = 2
dice_count = 1
dice_sides = 4
dice_bonus = 1

