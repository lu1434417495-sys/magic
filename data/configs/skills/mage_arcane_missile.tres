[resource]
script = ExtResource("3_skill")
skill_id = &"mage_arcane_missile"
display_name = "奥术飞弹"
icon_id = &""
description = "编排一组无需武器的奥术力场飞弹。每枚飞弹必定命中且不能暴击，可重复指定同一目标，并严格按选择顺序逐发结算；若既定目标提前倒下，分配给它的后续飞弹会消散。技能无冷却，法力与体力均按实际发射数量线性消耗。"
max_level = 5
non_core_max_level = 3
dynamic_max_level_stat_id = &"profession_rank:mage"
dynamic_max_level_base = 5
dynamic_max_level_per_stat = -2
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000, 17000, 22000, 28000)
tags = Array[StringName]([&"mage", &"magic", &"arcane", &"output"])
growth_tier = &"basic"
attribute_growth_progress = {
"intelligence": 60
}
level_description_template = "射程{range}（需要视线），可编排1至{missiles}枚力场飞弹；每枚必定命中且不能暴击，造成{dmg}力场伤害，可重复指定同一目标并按选择顺序逐发结算。无需武器。消耗1AP；每枚消耗{mp_per}法力/{stamina_per}体力，满额共{mp_total}法力/{stamina_total}体力；无冷却。动态最大等级:{dynamic_max_level}"
