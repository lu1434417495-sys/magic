[gd_resource type="Resource" script_class="SkillDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_nirvana_heal"]
script = ExtResource("1_effect")
effect_type = &"heal"
effect_target_team_filter = &"ally"
dice_count = 3
dice_sides = 8

[sub_resource type="Resource" id="Effect_nirvana_dispel"]
script = ExtResource("1_effect")
effect_type = &"dispel_magic"
effect_target_team_filter = &"ally"
effect_categories = Array[StringName]([&"antimagic"])
remove_harmful = true
remove_harmful_from_allies = true
max_status_removed = 1

[sub_resource type="Resource" id="Combat_nirvana_fire"]
script = ExtResource("2_combat")
skill_id = &"equipment_phoenix_rebirth_necklace_nirvana_fire"
target_mode = &"unit"
target_team_filter = &"ally"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 1
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
attack_resolution_mode = &"direct_effect"
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"equipment", &"phoenix_rebirth", &"heal", &"cleanse", &"fire"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_nirvana_heal"), SubResource("Effect_nirvana_dispel")])

[resource]
script = ExtResource("3_skill")
skill_id = &"equipment_phoenix_rebirth_necklace_nirvana_fire"
display_name = "涅槃之火"
icon_id = &""
description = "装备技能。消耗1 AP，使自身或1格内一个友方恢复3D8 HP，并移除至多一个可驱散有害魔法；传奇或不可驱散状态不受影响。每个世界日一次。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"phoenix_rebirth", &"heal", &"cleanse", &"fire", &"legendary"])
learn_source = &"innate"
combat_profile = SubResource("Combat_nirvana_fire")
