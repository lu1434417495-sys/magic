range_value = 0
ap_cost = 1
mastery_trigger_mode = &"effect_applied"
ai_tags = Array[StringName]([&"equipment", &"weapon", &"buff"])

[resource]
script = ExtResource("2_skill")
skill_id = &"weapon_sword_starfell_star_map_guidance"
