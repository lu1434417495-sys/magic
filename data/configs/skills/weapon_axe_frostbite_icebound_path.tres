[resource]
script = ExtResource("4_skill")
skill_id = &"weapon_axe_frostbite_icebound_path"
display_name = "冰封之路"
icon_id = &"weapon_axe_frostbite_icebound_path"
description = "装备技能。选择相邻 1 格水域，将其冻结为冰层；消耗 60 体力，冷却 120TU。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"frostbite", &"weapon", &"terrain", &"freeze"])
