[sub_resource type="Resource" id="Effect_icebound_path_freeze"]
script = ExtResource("1_effect")
effect_type = &"terrain_replace"
terrain_replace_to = &"ice"

[sub_resource type="Resource" id="Variant_icebound_path_single_water"]
script = ExtResource("2_variant")
variant_id = &"ice_single_water"
display_name = "单格冰层"
description = "将相邻 1 格水域冻结为冰层。"
target_mode = &"ground"
footprint_pattern = &"single"
required_coord_count = 1
allowed_base_terrains = Array[StringName]([&"water", &"shallow_water", &"flowing_water", &"deep_water"])
