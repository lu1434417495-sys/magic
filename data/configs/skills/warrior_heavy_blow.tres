		"cap": "不设技能上限（仍受体质自然上限约束）",
		"stamina": "10",
		"cooldown": "60"
	}
}
tags = Array[StringName]([&"warrior", &"melee", &"output"])
combat_profile = SubResource("Resource_combat")
