[sub_resource type="Resource" id="Combat"]
script = ExtResource("2_combat")
skill_id = &"mage_prismatic_green_ward"
delivery_categories = Array[StringName]([&"spell", &"force_effect"])
target_mode = &"unit"
target_team_filter = &"self"
range_value = 0
area_pattern = &"self"
ap_cost = 2
mp_cost = 70
cooldown_tu = 20
level_overrides = {
3: {
"cooldown_tu": 15
}
}
mastery_trigger_mode = &"effect_applied"
target_selection_mode = &"self"
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_l0"), SubResource("Effect_l3"), SubResource("Effect_l5")])

[resource]
script = ExtResource("3_skill")
skill_id = &"mage_prismatic_green_ward"
display_name = "虹光·翠绿屏障"
icon_id = &"mage_prismatic_sphere"
description = "创造单独的绿色虹光屏障，阻挡吐息武器；穿越者必须抵抗致命毒素。"
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500)
