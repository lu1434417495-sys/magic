max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
level_description_template = "自身周围2格的狼类友军攻击检定+{hit}，持续{duration}TU。消耗1AP/20体力，冷却120TU。"
