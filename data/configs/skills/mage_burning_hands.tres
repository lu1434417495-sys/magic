[resource]
script = ExtResource("3_skill")
skill_id = &"mage_burning_hands"
display_name = "焚掌喷流"
icon_id = &""
description = "选择相邻地格确定喷流方向，对锥形范围内所有单位造成火焰伤害；敏捷豁免成功伤害减半。3级起，豁免失败者还会燃烧：同一施法者的本技能最多叠加3层；不同施法者或其他技能/效果形成独立来源，分别叠加、计时和结算。"
max_level = 7
non_core_max_level = 5
mastery_curve = PackedInt32Array(400, 1000, 2200, 4000, 6500, 9500, 13000)
tags = Array[StringName]([&"mage", &"magic", &"fire", &"aoe", &"output", &"control"])
growth_tier = &"advanced"
attribute_growth_progress = {
"intelligence": 110,
"perception": 20,
"willpower": 50
}
level_description_template = "选择相邻地格确定方向；自身前方{area}内所有单位进行敏捷豁免，失败受到{dmg}火焰伤害，成功减半{{?burn}}；失败者附加燃烧（强度{burn_power}，持续{burn_duration}TU，每{burn_tick}TU结算；同源最多3层，不同施法者或其他技能/效果独立叠加、计时和结算）{{/burn}}。消耗{ap}AP/{mp}法力，冷却{cooldown}TU"
level_description_configs = {
