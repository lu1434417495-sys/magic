[gd_resource type="Resource" script_class="SkillDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_death_sentence_status"]
script = ExtResource("1_effect")
effect_type = &"status"
effect_target_team_filter = &"enemy"
status_id = &"executioner_death_sentence"
power = 1
duration_tu = 60
stack_behavior = &"refresh"
stack_limit = 1
counts_as_debuff_override = true
counts_as_debuff = true
undispellable = true
effect_tags = Array[StringName]([&"executioner", &"death_sentence", &"mark"])

[sub_resource type="Resource" id="Combat_death_sentence"]
script = ExtResource("2_combat")
skill_id = &"weapon_axe_executioner_death_sentence"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 1
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
stamina_cost = 60
cooldown_tu = 300
attack_resolution_mode = &"direct_effect"
mastery_trigger_mode = &"effect_applied"
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"equipment", &"executioner", &"weapon", &"mark"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_death_sentence_status")])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_axe_executioner_death_sentence"
display_name = "死亡判决"
icon_id = &"weapon_axe_executioner_death_sentence"
description = "装备技能。对相邻敌人施加 60TU 死亡判决；下一次使用处刑者之斧成功命中时，该次命中变为暴击并结算 DC16 体质判决。消耗 1AP 与 60 体力，冷却 300TU。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"executioner", &"weapon", &"mark"])
learn_source = &"innate"
combat_profile = SubResource("Combat_death_sentence")
