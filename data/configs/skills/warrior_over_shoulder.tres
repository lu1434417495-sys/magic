[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="3_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Resource_ef0"]
script = ExtResource("3_effect")
effect_type = &"damage"
min_skill_level = 0
max_skill_level = -1
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
dice_count = 1
dice_sides = 4
max_skill_level = 3

[sub_resource type="Resource" id="Resource_ef1"]
script = ExtResource("3_effect")
effect_type = &"damage"
min_skill_level = 4
max_skill_level = -1
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
dice_count = 1
dice_sides = 6

[sub_resource type="Resource" id="Resource_vault"]
script = ExtResource("3_effect")
effect_type = &"vault_behind_target"
min_skill_level = 0
max_skill_level = -1

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("4_combat")
skill_id = &"warrior_over_shoulder"
range_value = 1
weapon_range_policy = &"configured"
ap_cost = 1
stamina_cost = 35
cooldown_tu = 40
attack_roll_bonus = 0
level_overrides = {
	3: {
		"stamina_cost": 25
	}
}
mastery_trigger_mode = &"skill_damage_dice_max"
mastery_amount_mode = &"per_target_rank"
effect_defs = Array[ExtResource("3_effect")]([SubResource("Resource_ef0"), SubResource("Resource_ef1"), SubResource("Resource_vault")])

[resource]
script = ExtResource("5_skill")
skill_id = &"warrior_over_shoulder"
display_name = "借势越肩"
description = "攻击相邻敌人；命中后越过目标，落到其正后方。若落点、墙体、高差或屏障阻挡路径，则无法施放。"
max_level = 5
non_core_max_level = 3
mastery_curve = PackedInt32Array(100, 250, 550, 1000, 1600)
growth_tier = &"basic"
attribute_growth_progress = { "agility": 40, "strength": 20 }
tags = Array[StringName]([&"warrior", &"melee", &"mobility"])
combat_profile = SubResource("Resource_combat")
