[gd_resource type="Resource" script_class="SkillDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_stored_thunder_weapon_damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_target_team_filter = &"enemy"
add_weapon_dice = true
requires_weapon = true
use_weapon_physical_damage_tag = true
resolve_as_weapon_attack = true

[sub_resource type="Resource" id="Effect_stored_thunder_lightning_damage"]
script = ExtResource("1_effect")
effect_type = &"damage"
effect_target_team_filter = &"enemy"
damage_tag = &"lightning"
dice_count = 3
dice_sides = 6

[sub_resource type="Resource" id="Combat_stored_thunder_shot"]
script = ExtResource("2_combat")
skill_id = &"weapon_bow_thunderbow_stored_thunder_shot"
target_mode = &"unit"
target_team_filter = &"enemy"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 4
area_pattern = &"single"
area_value = 0
requires_los = true
ap_cost = 1
stamina_cost = 60
cooldown_tu = 300
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
required_weapon_families = Array[StringName]([&"bow"])
delivery_categories = Array[StringName]([&"equipment", &"thunderbow", &"bow", &"weapon", &"thunder", &"lightning"])
projectile_kind = &"magical"
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_stored_thunder_weapon_damage"), SubResource("Effect_stored_thunder_lightning_damage")])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_bow_thunderbow_stored_thunder_shot"
display_name = "蓄雷矢"
icon_id = &"weapon_bow_thunderbow_stored_thunder_shot"
description = "装备技能。1AP、60体力，冷却 300TU；对 4 格内敌人进行武器攻击，命中造成武器伤害+3D6 lightning。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"thunderbow", &"bow", &"weapon", &"thunder", &"lightning"])
learn_source = &"innate"
combat_profile = SubResource("Combat_stored_thunder_shot")
