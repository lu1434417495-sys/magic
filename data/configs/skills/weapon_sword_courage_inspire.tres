[gd_resource type="Resource" script_class="SkillDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="2_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="3_skill"]

[sub_resource type="Resource" id="Effect_courage_inspired"]
script = ExtResource("1_effect")
effect_type = &"status"
effect_target_team_filter = &"ally"
status_id = &"courage_inspired"
power = 1
duration_tu = 60
stack_behavior = &"refresh"
stack_limit = 1
display_name = "鼓舞"
dispellable_beneficial_magic = true
attack_roll_bonus = 2
consume_on_next_attack_check = true
consume_on_next_save = true
save_bonus = 2

[sub_resource type="Resource" id="Combat_courage_inspire"]
script = ExtResource("2_combat")
skill_id = &"weapon_sword_courage_inspire"
target_mode = &"unit"
target_team_filter = &"ally"
target_selection_mode = &"single_unit"
range_pattern = &"single"
range_value = 6
weapon_range_policy = &"configured"
area_pattern = &"single"
area_value = 0
ap_cost = 0
cooldown_tu = 60
attack_resolution_mode = &"direct_effect"
min_target_count = 1
max_target_count = 1
allow_repeat_target = false
selection_order_mode = &"stable"
delivery_categories = Array[StringName]([&"equipment", &"courage", &"weapon", &"support"])
effect_defs = Array[ExtResource("1_effect")]([SubResource("Effect_courage_inspired")])
required_weapon_families = Array[StringName]([&"sword"])

[resource]
script = ExtResource("3_skill")
skill_id = &"weapon_sword_courage_inspire"
display_name = "鼓舞"
icon_id = &"weapon_sword_courage_inspire"
description = "装备技能。选择 6 格内盟友，使其 60TU 内下一次攻击检定和下一次豁免各获得 +2；0AP，冷却 60TU。"
skill_type = &"active"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(20)
tags = Array[StringName]([&"equipment", &"courage", &"longsword", &"support", &"weapon"])
learn_source = &"innate"
combat_profile = SubResource("Combat_courage_inspire")
