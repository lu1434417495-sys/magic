}
max_level = 9
non_core_max_level = 7
mastery_curve = PackedInt32Array(240, 600, 1320, 2400, 3840, 5640, 7800, 10320, 13200)
growth_tier = &"advanced"
attribute_growth_progress = { "agility": 90, "strength": 90 }
tags = Array[StringName]([&"warrior", &"melee", &"mobility", &"output"])
combat_profile = SubResource("Combat_phantom_through")
