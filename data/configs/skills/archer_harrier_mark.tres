[resource]
script = ExtResource("3_skill")
skill_id = &"archer_harrier_mark"
display_name = "猎印追缉"
icon_id = &"archer_harrier_mark"
description = "锁定一个可见敌人。标记期间，只有施放者以武器或天生武器命中该目标时才会追加伤害骰；其他单位与非武器伤害不会触发。等级提升会强化追加骰、延长持续时间、增加射程并降低体力与冷却压力。"
level_description_template = "标记目标{duration}TU；施放者以武器或天生武器命中目标时额外造成{bonus_damage}伤害。射程{range}，消耗{ap}AP/{stamina}体力，冷却{cooldown}TU。"
