[gd_resource type="Resource" script_class="EquipmentAbilityContentPackDef" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/EquipmentAbilityContentPackDef.cs" id="1_pack"]
[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/EquipmentAbilityBindingDef.cs" id="2_binding"]
[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/EquipmentAbilityReactionDef.cs" id="3_reaction"]
[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/EquipmentAbilityActionDef.cs" id="4_action"]
[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/AttackRollBonusActionPayloadDef.cs" id="5_attack_bonus"]
[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/EquipmentGrantedActionDef.cs" id="6_grant"]

[sub_resource type="Resource" id="Action_wind_guided_payload"]
script = ExtResource("5_attack_bonus")
target_selector = &"attack_target"
attribute_modifier_id = &"perception_modifier"
stack_mode = &"max"
label = "风引射击"
require_weapon_damage = true

[sub_resource type="Resource" id="Action_wind_guided"]
script = ExtResource("4_action")
action_id = &"action.windbow.wind_guided_shot.perception_attack_roll"
kind = &"attack_roll_bonus"
payload = SubResource("Action_wind_guided_payload")

[sub_resource type="Resource" id="Reaction_wind_guided"]
script = ExtResource("3_reaction")
reaction_id = &"reaction.windbow.wind_guided_shot.before_hit"
trigger = &"on_hit"
timing = &"before_hit"
actions = Array[Resource]([SubResource("Action_wind_guided")])

[sub_resource type="Resource" id="Grant_gale_push_skill"]
script = ExtResource("6_grant")
granted_action_id = &"grant.windbow.gale_push.skill"
granted_kind = &"skill"
skill_id = &"weapon_bow_windbow_gale_push"
skill_level = 1
display_category = &"equipment"
display_priority = 100

[sub_resource type="Resource" id="Binding_wind_guided"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.bow.windbow.wind_guided_shot"
trait_id = &"weapon.bow.windbow.wind_guided_shot"
override_mode = &"add"
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
required_trait_categories = Array[StringName]([&"weapon_feat"])
required_item_tags = Array[StringName]([&"windbow"])
supported_equipment_type_ids = Array[StringName]([&"weapon"])
reactions = Array[Resource]([SubResource("Reaction_wind_guided")])

[sub_resource type="Resource" id="Binding_gale_push"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.bow.windbow.gale_push"
trait_id = &"weapon.bow.windbow.gale_push"
override_mode = &"add"
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
required_trait_categories = Array[StringName]([&"weapon_feat"])
required_item_tags = Array[StringName]([&"windbow"])
supported_equipment_type_ids = Array[StringName]([&"weapon"])
granted_actions = Array[Resource]([SubResource("Grant_gale_push_skill")])

[resource]
script = ExtResource("1_pack")
pack_id = &"equipment_ability.weapon.bow.windbow"
schema_version = 1
load_order = 151
bindings = Array[Resource]([SubResource("Binding_wind_guided"), SubResource("Binding_gale_push")])
