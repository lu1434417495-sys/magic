[sub_resource type="Resource" id="Action_rust_corrosion_payload"]
script = ExtResource("14_apply_status")
target_selector = &"attack_target"
status_id = &"rustoath_rust_corrosion"
duration_tu = 180
stack_delta = 1
stack_behavior = &"add"
stack_limit = 5
display_label = "锈蚀"
attack_roll_penalty = 0
counts_as_debuff_override = true
counts_as_debuff = true

[sub_resource type="Resource" id="Action_rust_corrosion"]
script = ExtResource("12_action")
action_id = &"action.rustoath.rust_corrosion.apply_status"
kind = &"apply_status"
payload = SubResource("Action_rust_corrosion_payload")

[sub_resource type="Resource" id="Reaction_rust_corrosion"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.rustoath.rust_corrosion.after_hit"
trigger = &"on_hit"
timing = &"after_hit"
priority = 10
actions = Array[Resource]([SubResource("Action_rust_corrosion")])

[sub_resource type="Resource" id="Binding_rust_corrosion"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.sword.rustoath.rust_corrosion"
trait_id = &"weapon.sword.rustoath.rust_corrosion"
override_mode = &"add"
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
required_trait_categories = Array[StringName]([&"weapon_feat"])
required_item_tags = Array[StringName]([&"rustoath"])
supported_equipment_type_ids = Array[StringName]([&"weapon"])
reactions = Array[Resource]([SubResource("Reaction_rust_corrosion")])

[sub_resource type="Resource" id="Fact_target_rust_stacks"]
