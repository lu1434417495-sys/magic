[sub_resource type="Resource" id="Dice_term_1d6_fire"]
script = ExtResource("6_dice_term")
dice_count = 1
dice_sides = 6

[sub_resource type="Resource" id="Dice_1d6_fire"]
script = ExtResource("5_dice")
terms = Array[Resource]([SubResource("Dice_term_1d6_fire")])

[sub_resource type="Resource" id="Action_flame_damage_payload"]
script = ExtResource("8_add_damage")
target_selector = &"attack_target"
dice = SubResource("Dice_1d6_fire")
damage_type = &"fire"
damage_tags = Array[StringName]([&"fire"])

[sub_resource type="Resource" id="Action_flame_damage"]
script = ExtResource("7_action")
action_id = &"action.flame_morningstar.flame_strike.add_fire_damage"
kind = &"add_damage_dice"
payload = SubResource("Action_flame_damage_payload")

[sub_resource type="Resource" id="Roll_term_d20"]
script = ExtResource("6_dice_term")
dice_count = 1
dice_sides = 20

[sub_resource type="Resource" id="Roll_d20"]
script = ExtResource("5_dice")
terms = Array[Resource]([SubResource("Roll_term_d20")])

[sub_resource type="Resource" id="Roll_gate_ignite"]
script = ExtResource("10_roll_gate")
rng_stream = &"equipment_ability.flame_morningstar.ignite"
roll = SubResource("Roll_d20")
compare = &"gte"
threshold = 11

[sub_resource type="Resource" id="Action_burning_payload"]
script = ExtResource("9_apply_status")
target_selector = &"target"
status_id = &"burning"
duration_tu = 60
stack_delta = 1
stack_behavior = &"add"
stack_limit = 3
display_label = "燃烧"
attack_roll_penalty = 0
counts_as_debuff_override = true
counts_as_debuff = true
dispellable_harmful_magic = true
tick_interval_tu = 10

[sub_resource type="Resource" id="Action_burning"]
script = ExtResource("7_action")
action_id = &"action.flame_morningstar.flame_strike.apply_burning"
kind = &"apply_status"
payload = SubResource("Action_burning_payload")

[sub_resource type="Resource" id="Reaction_flame_damage"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.flame_morningstar.flame_strike.damage_after_hit"
trigger = &"on_hit"
timing = &"after_hit"
actions = Array[Resource]([SubResource("Action_flame_damage")])

[sub_resource type="Resource" id="Reaction_flame_burning"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.flame_morningstar.flame_strike.burning_after_hit"
trigger = &"on_hit"
timing = &"after_hit"
