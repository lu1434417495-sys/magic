[sub_resource type="Resource" id="Trace_dragon_flame"]
script = ExtResource("3_trace")
source_kind = &"by_family"
source_file = "docs/design/weapons/by_family/axes_01.md"
item_id = &"weapon_unique_axe_dragonbone_096"
display_name = "龙骨斧"
bullet_index = 1
bullet_title = "龙焰"
bullet_text = "攻击时可附加2D6火焰伤害（每回合限一次）"
mechanism_family = &"add_damage_dice_per_turn"
coverage_status = &"bound"
phase = &"v1"
test_id = &"dragonbone_dragon_flame"

[sub_resource type="Resource" id="Dice_term_2d6"]
script = ExtResource("10_dice_term")
dice_count = 2
dice_sides = 6

[sub_resource type="Resource" id="Dice_2d6"]
script = ExtResource("9_dice")
terms = Array[Resource]([SubResource("Dice_term_2d6")])

[sub_resource type="Resource" id="Action_dragon_flame_payload"]
script = ExtResource("12_add_damage")
target_selector = &"attack_target"
dice = SubResource("Dice_2d6")
damage_type = &"fire"
damage_tags = Array[StringName]([&"fire"])

[sub_resource type="Resource" id="Action_dragon_flame"]
script = ExtResource("11_action")
action_id = &"action.dragonbone.dragon_flame.add_fire_damage"
kind = &"add_damage_dice"
payload = SubResource("Action_dragon_flame_payload")

[sub_resource type="Resource" id="Reaction_dragon_flame"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.dragonbone.dragon_flame.after_hit"
trigger = &"on_hit"
timing = &"after_hit"
once_scope = &"turn"
actions = Array[Resource]([SubResource("Action_dragon_flame")])

[sub_resource type="Resource" id="Binding_dragon_flame"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.axe.dragonbone.dragon_flame"
trait_id = &"weapon.axe.dragonbone.dragon_flame"
override_mode = &"add"
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
required_trait_categories = Array[StringName]([&"weapon_feat"])
required_item_tags = Array[StringName]([&"dragonbone"])
supported_equipment_type_ids = Array[StringName]([&"weapon"])
source_traces = Array[Resource]([SubResource("Trace_dragon_flame")])
reactions = Array[Resource]([SubResource("Reaction_dragon_flame")])

[sub_resource type="Resource" id="Trace_dragon_hate"]
script = ExtResource("3_trace")
source_kind = &"by_family"
source_file = "docs/design/weapons/by_family/axes_01.md"
item_id = &"weapon_unique_axe_dragonbone_096"
display_name = "龙骨斧"
