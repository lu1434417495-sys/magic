[sub_resource type="Resource" id="Trace_stardust_touch"]
script = ExtResource("3_trace")
source_kind = &"by_family"
source_file = "docs/design/weapons/by_family/axes_01.md"
item_id = &"weapon_unique_axe_starfragment_100"
display_name = "星辰碎片"
bullet_index = 1
bullet_title = "星尘之触"
bullet_text = "battle_environment_tag 包含 night 时，命中后附加1D6 force伤害"
mechanism_family = &"battle_environment_add_damage_dice"
coverage_status = &"bound"
phase = &"v1"
test_id = &"starfragment_stardust_touch"

[sub_resource type="Resource" id="Fact_battle_environment_tag"]
script = ExtResource("8_fact_query")
query_kind = &"fact"
fact_id = &"battle_environment_tag"
value_kind = &"string_name_set"

[sub_resource type="Resource" id="Literal_night"]
script = ExtResource("8_fact_query")
query_kind = &"literal"
value_kind = &"string_name"
string_name_literal = &"night"

[sub_resource type="Resource" id="Compare_stardust_night_payload"]
script = ExtResource("7_compare_payload")
left = SubResource("Fact_battle_environment_tag")
compare = &"contains"
right = SubResource("Literal_night")

[sub_resource type="Resource" id="Condition_stardust_night"]
script = ExtResource("6_condition")
condition_id = &"condition.starfragment.stardust_touch.night"
kind = &"compare_fact"
payload = SubResource("Compare_stardust_night_payload")

[sub_resource type="Resource" id="Condition_group_stardust_night"]
script = ExtResource("5_condition_group")
mode = &"all"
conditions = Array[Resource]([SubResource("Condition_stardust_night")])

[sub_resource type="Resource" id="Dice_term_1d6_force"]
script = ExtResource("10_dice_term")
dice_count = 1
dice_sides = 6

[sub_resource type="Resource" id="Dice_1d6_force"]
script = ExtResource("9_dice")
terms = Array[Resource]([SubResource("Dice_term_1d6_force")])

[sub_resource type="Resource" id="Action_stardust_touch_payload"]
script = ExtResource("12_add_damage")
target_selector = &"attack_target"
dice = SubResource("Dice_1d6_force")
damage_type = &"force"
damage_tags = Array[StringName]([&"force"])

[sub_resource type="Resource" id="Action_stardust_touch"]
script = ExtResource("11_action")
action_id = &"action.starfragment.stardust_touch.add_force_damage"
kind = &"add_damage_dice"
payload = SubResource("Action_stardust_touch_payload")

[sub_resource type="Resource" id="Reaction_stardust_touch"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.starfragment.stardust_touch.after_hit"
trigger = &"on_hit"
timing = &"after_hit"
condition_group = SubResource("Condition_group_stardust_night")
actions = Array[Resource]([SubResource("Action_stardust_touch")])

[sub_resource type="Resource" id="Binding_stardust_touch"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.axe.starfragment.stardust_touch"
trait_id = &"weapon.axe.starfragment.stardust_touch"
override_mode = &"add"
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
required_trait_categories = Array[StringName]([&"weapon_feat"])
required_item_tags = Array[StringName]([&"starfragment"])
supported_equipment_type_ids = Array[StringName]([&"weapon"])
source_traces = Array[Resource]([SubResource("Trace_stardust_touch")])
reactions = Array[Resource]([SubResource("Reaction_stardust_touch")])

