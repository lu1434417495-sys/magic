[sub_resource type="Resource" id="Fact_environment_tags"]
script = ExtResource("8_fact_query")
query_kind = &"fact"
fact_id = &"battle_environment_tag"
value_kind = &"string_name_set"

[sub_resource type="Resource" id="Literal_rain"]
script = ExtResource("8_fact_query")
query_kind = &"literal"
value_kind = &"string_name"
string_name_literal = &"rain"

[sub_resource type="Resource" id="Literal_wet"]
script = ExtResource("8_fact_query")
query_kind = &"literal"
value_kind = &"string_name"
string_name_literal = &"wet"

[sub_resource type="Resource" id="Compare_env_contains_rain"]
