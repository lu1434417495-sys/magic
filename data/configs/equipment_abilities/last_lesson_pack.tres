script = ExtResource("9_action")
action_id = &"action.last_lesson.inheritance_seal.damage_roll_maximum"
kind = &"damage_roll_mode_override"
payload = SubResource("Action_damage_roll_maximum_payload")

[sub_resource type="Resource" id="Reaction_inheritance_skill_used"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.last_lesson.inheritance_seal.after_skill"
trigger = &"on_granted_skill_used"
timing = &"after_skill"
actions = Array[Resource]([SubResource("Action_consume_three_teachings"), SubResource("Action_mark_max_damage"), SubResource("Action_mark_skip_teaching")])

[sub_resource type="Resource" id="Reaction_inheritance_damage_roll"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.last_lesson.inheritance_seal.before_damage"
trigger = &"on_damage_roll"
timing = &"before_damage"
condition_group = SubResource("Condition_group_maximize_damage")
actions = Array[Resource]([SubResource("Action_damage_roll_maximum")])

[sub_resource type="Resource" id="Binding_inheritance_seal"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.sword.last_lesson.inheritance_seal"
trait_id = &"weapon.sword.last_lesson.inheritance_seal"
override_mode = &"add"
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
required_trait_categories = Array[StringName]([&"weapon_feat"])
required_item_tags = Array[StringName]([&"last_lesson"])
supported_equipment_type_ids = Array[StringName]([&"weapon"])
state_schemas = Array[Resource]([SubResource("State_maximize_damage_current_turn")])
reactions = Array[Resource]([SubResource("Reaction_inheritance_skill_used"), SubResource("Reaction_inheritance_damage_roll")])
granted_actions = Array[Resource]([SubResource("Grant_inheritance_seal_skill")])

[sub_resource type="Resource" id="Action_aura_enemy_1_payload"]
