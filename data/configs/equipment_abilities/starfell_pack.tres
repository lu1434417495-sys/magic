bullet_title = "星坠"
bullet_text = "消耗5层星尘，10尺半径，目标 agility DC16；失败6D6 force+fire，成功半伤；建筑和非魔法构造物受到双倍伤害；每场战斗1次。"
mechanism_family = &"granted_area_skill_dual_damage_target_multiplier"
coverage_status = &"bound"
phase = &"v1"
test_id = &"starfell_starfall"
note = "当前技能已接入 dual damage segment 与 building/nonmagical construct target multiplier；星尘消费后续接入。"

