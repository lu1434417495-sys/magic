[sub_resource type="Resource" id="Trace_meteor_force"]
script = ExtResource("3_trace")
source_kind = &"by_family"
source_file = "docs/design/weapons/by_family/swords_01.md"
item_id = &"weapon_unique_sword_starfell_016"
display_name = "群星之末"
bullet_index = 1
bullet_title = "陨星之力"
bullet_text = "命中目标后在目标身上叠加星尘，最多5层；每层使后续攻击追加1D6 force。"
mechanism_family = &"hit_status_stack_scaling_force_damage"
coverage_status = &"deferred"
phase = &"v1"
test_id = &"starfell_meteor_force"
note = "星尘层数和消费规则需要独立行为回归，本切片只投影来源。"

