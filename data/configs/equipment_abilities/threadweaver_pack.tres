[sub_resource type="Resource" id="Trace_fate_thread"]
script = ExtResource("3_trace")
source_kind = &"by_family"
source_file = "docs/design/weapons/by_family/swords_01.md"
item_id = &"weapon_unique_sword_threadweaver_019"
display_name = "织命"
bullet_index = 1
bullet_title = "命运之线"
bullet_text = "命中目标时叠加1层命运线（最多3层），每层使你对该目标的攻击检定获得+1加值；命运线仅对单一目标累积，切换目标则旧目标线保留1回合后消失。"
mechanism_family = &"hit_status_stack_source_bound_attack_bonus"
coverage_status = &"bound"
phase = &"v1"
test_id = &"threadweaver_fate_thread"
note = "V1以30TU自然过期表达旧目标线保留1回合，不强制单目标清旧线。"

