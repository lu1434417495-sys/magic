[sub_resource type="Resource" id="Fact_target_creature_tags"]
script = ExtResource("8_fact_query")
query_kind = &"fact"
fact_id = &"creature_type_tags"
subject = &"target"
value_kind = &"string_name_set"

[sub_resource type="Resource" id="Literal_undead"]
script = ExtResource("8_fact_query")
query_kind = &"literal"
value_kind = &"string_name"
string_name_literal = &"undead"

[sub_resource type="Resource" id="Compare_target_undead_payload"]
script = ExtResource("7_compare_payload")
left = SubResource("Fact_target_creature_tags")
compare = &"contains"
right = SubResource("Literal_undead")

[sub_resource type="Resource" id="Condition_target_undead"]
script = ExtResource("6_condition")
condition_id = &"condition.sacred_hammer.target_undead"
kind = &"compare_fact"
payload = SubResource("Compare_target_undead_payload")

[sub_resource type="Resource" id="Condition_group_target_undead"]
script = ExtResource("5_condition_group")
mode = &"all"
conditions = Array[Resource]([SubResource("Condition_target_undead")])

[sub_resource type="Resource" id="Dice_term_1d8_radiant"]
script = ExtResource("10_dice_term")
dice_count = 1
dice_sides = 8

[sub_resource type="Resource" id="Dice_1d8_radiant"]
script = ExtResource("9_dice")
terms = Array[Resource]([SubResource("Dice_term_1d8_radiant")])

[sub_resource type="Resource" id="Dice_term_3d6_radiant"]
script = ExtResource("10_dice_term")
