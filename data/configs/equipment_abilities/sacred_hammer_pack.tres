actions = Array[Resource]([SubResource("Action_radiant_strike")])

[sub_resource type="Resource" id="Binding_radiant_strike"]
script = ExtResource("2_binding")
binding_id = &"binding.weapon.warhammer.sacred.radiant_strike"
trait_id = &"weapon.warhammer.sacred.radiant_strike"
override_mode = &"add"
