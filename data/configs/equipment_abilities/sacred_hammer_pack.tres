dice_sides = 6

[sub_resource type="Resource" id="Dice_3d6_radiant"]
script = ExtResource("9_dice")
terms = Array[Resource]([SubResource("Dice_term_3d6_radiant")])

[sub_resource type="Resource" id="Action_radiant_strike_payload"]
script = ExtResource("12_add_damage")
target_selector = &"attack_target"
dice = SubResource("Dice_1d8_radiant")
damage_type = &"radiant"
damage_tags = Array[StringName]([&"radiant"])

[sub_resource type="Resource" id="Action_radiant_strike"]
script = ExtResource("11_action")
action_id = &"action.sacred_hammer.radiant_strike.add_radiant_damage"
kind = &"add_damage_dice"
payload = SubResource("Action_radiant_strike_payload")

[sub_resource type="Resource" id="Reaction_radiant_strike"]
script = ExtResource("4_reaction")
reaction_id = &"reaction.sacred_hammer.radiant_strike.after_hit"
trigger = &"on_hit"
