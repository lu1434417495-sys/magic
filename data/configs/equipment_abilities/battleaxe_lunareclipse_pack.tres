[ext_resource type="Script" path="res://scripts/player/progression/equipment_abilities/EquipmentGrantedActionDef.cs" id="15_grant"]

[sub_resource type="Resource" id="Literal_one"]
script = ExtResource("7_fact_query")
query_kind = &"literal"
value_kind = &"int"
int_literal = 1

[sub_resource type="Resource" id="Literal_three"]
script = ExtResource("7_fact_query")
query_kind = &"literal"
value_kind = &"int"
int_literal = 3

[sub_resource type="Resource" id="Fact_hp_damage"]
script = ExtResource("7_fact_query")
query_kind = &"fact"
fact_id = &"hp_damage"
value_kind = &"int"

[sub_resource type="Resource" id="Fact_source_moon_phase"]
script = ExtResource("7_fact_query")
query_kind = &"fact"
fact_id = &"status_stacks"
subject = &"source"
status_id = &"lunareclipse_moon_phase"
value_kind = &"int"

[sub_resource type="Resource" id="Compare_hp_damage_gte_one"]
script = ExtResource("6_compare_payload")
left = SubResource("Fact_hp_damage")
compare = &"gte"
right = SubResource("Literal_one")

[sub_resource type="Resource" id="Compare_source_moon_phase_gte_three"]
script = ExtResource("6_compare_payload")
left = SubResource("Fact_source_moon_phase")
compare = &"gte"
right = SubResource("Literal_three")

[sub_resource type="Resource" id="Condition_hp_damage"]
script = ExtResource("5_condition")
condition_id = &"condition.lunareclipse.hp_damage"
kind = &"compare_fact"
payload = SubResource("Compare_hp_damage_gte_one")

[sub_resource type="Resource" id="Condition_source_moon_phase_three"]
script = ExtResource("5_condition")
condition_id = &"condition.lunareclipse.source_moon_phase_three"
kind = &"compare_fact"
payload = SubResource("Compare_source_moon_phase_gte_three")

[sub_resource type="Resource" id="Condition_payload_source_heavy_armor"]
script = ExtResource("14_equipment_tag")
subject = &"source"
equipment_selector = &"body"
any_tags = Array[StringName]([&"heavy_armor"])

[sub_resource type="Resource" id="Condition_source_heavy_armor"]
script = ExtResource("5_condition")
condition_id = &"condition.lunareclipse.source_heavy_armor"
kind = &"has_equipment_tag"
payload = SubResource("Condition_payload_source_heavy_armor")

[sub_resource type="Resource" id="Condition_group_hp_damage"]
script = ExtResource("4_condition_group")
mode = &"all"
conditions = Array[Resource]([SubResource("Condition_hp_damage")])

[sub_resource type="Resource" id="Condition_group_source_moon_phase_three"]
script = ExtResource("4_condition_group")
mode = &"all"
conditions = Array[Resource]([SubResource("Condition_source_moon_phase_three")])

[sub_resource type="Resource" id="Condition_group_hp_damage_and_moon_phase_three"]
script = ExtResource("4_condition_group")
mode = &"all"
conditions = Array[Resource]([SubResource("Condition_hp_damage"), SubResource("Condition_source_moon_phase_three")])

[sub_resource type="Resource" id="Condition_group_not_heavy_armor"]
script = ExtResource("4_condition_group")
mode = &"all"
negate = true
conditions = Array[Resource]([SubResource("Condition_source_heavy_armor")])

[sub_resource type="Resource" id="Dice_term_2d8_radiant"]
script = ExtResource("9_dice_term")
dice_count = 2
dice_sides = 8

[sub_resource type="Resource" id="Dice_2d8_radiant"]
script = ExtResource("8_dice")
terms = Array[Resource]([SubResource("Dice_term_2d8_radiant")])

[sub_resource type="Resource" id="Action_full_moon_damage_payload"]
script = ExtResource("11_add_damage")
target_selector = &"attack_target"
dice = SubResource("Dice_2d8_radiant")
damage_type = &"radiant"
damage_tags = Array[StringName]([&"radiant"])

[sub_resource type="Resource" id="Action_full_moon_damage"]
script = ExtResource("10_action")
action_id = &"action.lunareclipse.full_moon_judgment.add_radiant_damage"
kind = &"add_damage_dice"
payload = SubResource("Action_full_moon_damage_payload")

[sub_resource type="Resource" id="Action_consume_moon_phase_payload"]
script = ExtResource("13_consume_stacks")
target_selector = &"source"
status_id = &"lunareclipse_moon_phase"
count = 3
require_source_unit_match = true
selection_mode = &"highest_stacks"

[sub_resource type="Resource" id="Action_consume_moon_phase"]
script = ExtResource("10_action")
action_id = &"action.lunareclipse.full_moon_judgment.consume_moon_phase"
kind = &"consume_status_stacks"
payload = SubResource("Action_consume_moon_phase_payload")

[sub_resource type="Resource" id="Action_moon_phase_payload"]
script = ExtResource("12_apply_status")
target_selector = &"source"
status_id = &"lunareclipse_moon_phase"
duration_tu = 180
stack_delta = 1
stack_behavior = &"add"
stack_limit = 3
display_label = "月相"
counts_as_debuff_override = true
counts_as_debuff = false
undispellable = true

[sub_resource type="Resource" id="Action_gain_moon_phase"]
script = ExtResource("10_action")
action_id = &"action.lunareclipse.moon_phase_cycle.gain_moon_phase"
kind = &"apply_status"
payload = SubResource("Action_moon_phase_payload")

[sub_resource type="Resource" id="Reaction_full_moon_damage"]
script = ExtResource("3_reaction")
reaction_id = &"reaction.lunareclipse.full_moon_judgment.after_hit"
trigger = &"on_hit"
timing = &"after_hit"
priority = 10
condition_group = SubResource("Condition_group_source_moon_phase_three")
actions = Array[Resource]([SubResource("Action_full_moon_damage")])

[sub_resource type="Resource" id="Reaction_full_moon_consume"]
script = ExtResource("3_reaction")
reaction_id = &"reaction.lunareclipse.full_moon_judgment.after_damage"
trigger = &"on_damage_applied"
timing = &"after_damage"
priority = 10
condition_group = SubResource("Condition_group_hp_damage_and_moon_phase_three")
actions = Array[Resource]([SubResource("Action_consume_moon_phase")])

[sub_resource type="Resource" id="Reaction_moon_phase_gain"]
script = ExtResource("3_reaction")
reaction_id = &"reaction.lunareclipse.moon_phase_cycle.after_hit"
trigger = &"on_hit"
timing = &"after_hit"
priority = 20
condition_group = SubResource("Condition_group_hp_damage")
actions = Array[Resource]([SubResource("Action_gain_moon_phase")])

[sub_resource type="Resource" id="Grant_shadowstep_skill"]
script = ExtResource("15_grant")
