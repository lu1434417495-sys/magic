[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/QuestDef.cs" id="1_questdef"]

[resource]
script = ExtResource("1_questdef")
quest_id = &"ashen_rift_warden"
display_name = "裂隙守望者"
description = "有人在维持裂隙的开放。消灭那些守护裂隙的编织者和迷雾兽——也许能延缓两个世界的融合。"
provider_kind = &"service_bounty_registry"
provider_interaction_id = &"service_bounty_registry"
listing_channels = Array[StringName]([&"bounty_registry"])
tags = Array[StringName]([&"ashen_intersection", &"abyss", &"bounty"])
accept_requirements = Array[Dictionary]([{&"requirement_type": &"quest_completed", &"quest_id": &"ashen_abyss_survival"}])
accept_dialogue_text = ""
accept_feedback_success = ""
accept_feedback_failure = ""
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"defeat_weavers", &"objective_type": &"defeat_enemy", &"target_id": &"mist_weaver", &"target_value": 5}, {&"objective_id": &"defeat_beasts", &"objective_type": &"defeat_enemy", &"target_id": &"mist_beast", &"target_value": 3}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 2000}, {&"reward_type": &"item", &"item_id": &"calamity_shard", &"quantity": 3}, {&"reward_type": &"pending_character_reward", &"member_id": &"hero", &"entries": Array[Dictionary]([{&"entry_type": &"attribute_progress", &"target_id": &"strength", &"amount": 10}, {&"entry_type": &"attribute_progress", &"target_id": &"agility", &"amount": 10}, {&"entry_type": &"attribute_progress", &"target_id": &"constitution", &"amount": 10}])}])
is_repeatable = false
