[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/QuestDef.cs" id="1_questdef"]

[resource]
script = ExtResource("1_questdef")
quest_id = &"bounty_wolf_pack"
display_name = "狼群悬赏"
description = "商道附近的荒狼群又聚集起来了。清理它们，赏金归你。"
provider_kind = &"service_bounty_registry"
provider_interaction_id = &"service_bounty_registry"
listing_channels = Array[StringName]([&"bounty_registry"])
listing_settlement_ids = Array[StringName]([&"template_town", &"template_city", &"template_capital", &"template_world_stronghold", &"template_metropolis"])
tags = Array[StringName]([&"bounty", &"repeatable", &"main_world"])
accept_requirements = Array[Dictionary]([])
accept_dialogue_text = ""
accept_feedback_success = ""
accept_feedback_failure = ""
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"defeat_wolves", &"objective_type": &"defeat_enemy", &"target_id": &"wolf_pack", &"target_value": 5}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 100}, {&"reward_type": &"item", &"item_id": &"beast_hide", &"quantity": 2}])
is_repeatable = true
failure_policy = &"terminal"
