accept_dialogue_text = ""
accept_feedback_success = ""
accept_feedback_failure = ""
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"defeat_wolves", &"objective_type": &"defeat_enemy", &"target_id": &"wolf_pack", &"target_value": 3}, {&"objective_id": &"report_back", &"objective_type": &"settlement_action", &"target_id": &"service_contract_board", &"target_value": 1}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 50}, {&"reward_type": &"pending_character_reward", &"member_id": &"hero", &"entries": Array[Dictionary]([{&"entry_type": &"skill_unlock", &"target_id": &"charge", &"amount": 1}])}])
