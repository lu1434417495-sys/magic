[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/QuestDef.cs" id="1_questdef"]

[resource]
script = ExtResource("1_questdef")
quest_id = &"tutorial_first_blood"
display_name = "初阵"
description = "村长告诉你，最近商路不太平。去村外清理几只在农田边缘徘徊的荒狼，证明你能保护自己。"
provider_kind = &"npc"
provider_interaction_id = &"npc_village_chief"
listing_channels = Array[StringName]([&"npc_offer"])
tags = Array[StringName]([&"tutorial", &"main_story"])
accept_requirements = Array[Dictionary]([])
accept_dialogue_text = "村外的荒狼已经逼近农田。先清理三只，证明你能保护自己。"
accept_feedback_success = "村长把清理荒狼的任务交给了你。"
accept_feedback_failure = "村长现在没有新的任务交给你。"
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"defeat_wolves", &"objective_type": &"defeat_enemy", &"target_id": &"wolf_pack", &"target_value": 3}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 50}, {&"reward_type": &"pending_character_reward", &"member_id": &"player_sword_01", &"entries": Array[Dictionary]([{&"entry_type": &"skill_mastery", &"target_id": &"warrior_heavy_strike", &"amount": 80}])}])
is_repeatable = false
failure_policy = &"terminal"
