reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 500}, {&"reward_type": &"pending_character_reward", &"member_id": &"hero", &"entries": Array[Dictionary]([{&"entry_type": &"attribute_progress", &"target_id": &"intelligence", &"amount": 25}])}])
