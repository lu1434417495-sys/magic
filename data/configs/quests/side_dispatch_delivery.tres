accept_feedback_success = ""
accept_feedback_failure = ""
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"deliver_dispatch", &"objective_type": &"submit_item", &"target_id": &"sealed_dispatch", &"target_value": 1}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 60}, {&"reward_type": &"pending_character_reward", &"member_id": &"hero", &"entries": Array[Dictionary]([{&"entry_type": &"attribute_progress", &"target_id": &"perception", &"amount": 10}])}])
