tags = Array[StringName]([&"contract", &"bounty"])
accept_requirements = Array[Dictionary]([])
accept_dialogue_text = ""
accept_feedback_success = ""
accept_feedback_failure = ""
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"defeat_enemy_once", &"objective_type": &"defeat_enemy", &"target_id": &"", &"target_value": 1}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 120}])
