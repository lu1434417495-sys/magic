[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/QuestDef.cs" id="1_questdef"]

[resource]
script = ExtResource("1_questdef")
quest_id = &"tutorial_wolf_alpha"
display_name = "狼群首领"
description = "普通荒狼只是前锋。一只体型巨大的狼群首领正在组织更有威胁的袭击。击败它，让商路恢复安全。"
provider_kind = &"npc"
provider_interaction_id = &"npc_old_hunter"
listing_channels = Array[StringName]([&"npc_offer"])
tags = Array[StringName]([&"tutorial", &"main_story"])
accept_requirements = Array[Dictionary]([{&"requirement_type": &"quest_completed", &"quest_id": &"tutorial_first_blood"}])
accept_dialogue_text = "普通荒狼只是前锋。等狼巢壮大后，那个带伤疤的首领就会现身。"
accept_feedback_success = "老猎人请你除掉狼群首领。"
accept_feedback_failure = "先完成村长交代的初阵任务。"
accept_confirmation_text = ""
objective_defs = Array[Dictionary]([{&"objective_id": &"defeat_alpha", &"objective_type": &"defeat_enemy", &"target_id": &"wolf_alpha", &"target_value": 1}])
reward_entries = Array[Dictionary]([{&"reward_type": &"gold", &"amount": 150}, {&"reward_type": &"pending_character_reward", &"member_id": &"player_sword_01", &"entries": Array[Dictionary]([{&"entry_type": &"skill_unlock", &"target_id": &"warrior_guard", &"amount": 1}])}])
is_repeatable = false
