[gd_resource type="Resource" script_class="ItemDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponProfileDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponDamageDiceDef.cs" id="3_dice"]

[sub_resource type="Resource" id="Resource_two_handed_dice"]
script = ExtResource("3_dice")
dice_count = 1
dice_sides = 10
flat_bonus = 2

[sub_resource type="Resource" id="Resource_weapon_profile"]
script = ExtResource("2_profile")
weapon_type_id = &"heavy_crossbow"
training_group = &"martial"
range_type = &"ranged"
family = &"crossbow"
damage_tag = &"physical_pierce"
attack_range = 10
two_handed_dice = SubResource("Resource_two_handed_dice")
properties_mode = 1
properties = Array[StringName]([&"two_handed", &"heavy", &"loading"])

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_crossbow_gorgon_329"
base_item_id = &"weapon_type_heavy_crossbow_base"
display_name = "蛇发女妖之弩"
description = "一柄镶嵌蛇发女妖眼石的重弩，命中的敌人会逐步僵硬为石。"
is_stackable = false
base_price = 58000
buy_price = 58000
sell_price = 29000
sellable = true
max_stack = 1
tags = Array[StringName]([&"gorgon_crossbow", &"heavy_crossbow", &"crossbow", &"petrification", &"heavy", &"loading"])
trait_ids = Array[StringName]([&"weapon.crossbow.gorgon.petrifying_gaze", &"weapon.crossbow.gorgon.complete_petrification", &"weapon.crossbow.gorgon.statue_shatter"])
weapon_profile = SubResource("Resource_weapon_profile")
