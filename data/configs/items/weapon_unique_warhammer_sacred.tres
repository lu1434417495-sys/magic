description = "铭刻祈祷文的独特战锤，命中时迸发圣光，并可触碰盟友恢复伤势。"
is_stackable = false
base_price = 65000
buy_price = 65000
sell_price = 32500
sellable = true
max_stack = 1
tags = Array[StringName]([&"sacred_hammer", &"warhammer", &"hammer", &"radiant", &"holy"])
