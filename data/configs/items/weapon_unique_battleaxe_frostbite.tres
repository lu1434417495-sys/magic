two_handed_dice = SubResource("Resource_two_handed_dice")
properties_mode = 2
properties = Array[StringName]([&"versatile"])

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_axe_frostbite_097"
base_item_id = &"weapon_type_battleaxe_base"
display_name = "霜咬"
description = "一柄覆着苍白冰痕的战斧。命中时附加寒冷伤害，连续三次命中同一目标会削弱其移动力；持有者可将相邻 1 格水域冻结成冰层。"
is_stackable = false
base_price = 40000
buy_price = 40000
sell_price = 20000
sellable = true
max_stack = 1
tags = Array[StringName]([&"versatile", &"frostbite", &"freeze", &"ice"])
trait_ids = Array[StringName]([&"weapon.axe.frostbite.frost_touch", &"weapon.axe.frostbite.icebound_path", &"weapon.axe.frostbite.polar_adaptation"])
weapon_profile = SubResource("Resource_weapon_profile")
