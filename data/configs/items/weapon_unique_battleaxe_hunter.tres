description = "一柄为狩猎而生的实用战斧。它对野兽更致命，并能让持有者以固定 3 级使用猎人标记。"
is_stackable = false
base_price = 35000
buy_price = 35000
sell_price = 17500
sellable = true
max_stack = 1
tags = Array[StringName]([&"versatile", &"hunter_axe", &"hunter", &"beast_slayer"])
