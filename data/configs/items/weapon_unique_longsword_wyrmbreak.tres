description = "以龙骨与焦黑钢脊重铸的长剑，锋缘残留炽热龙息。"
is_stackable = false
base_price = 140000
buy_price = 140000
sell_price = 70000
sellable = true
max_stack = 1
tags = Array[StringName]([&"wyrmbreak", &"dragonbone", &"dragon_slayer", &"fire"])
trait_ids = Array[StringName]([&"weapon.sword.wyrmbreak.dragon_slayer", &"weapon.sword.wyrmbreak.bone_stealing_fury", &"weapon.sword.wyrmbreak.dragon_soul_extension", &"weapon.sword.wyrmbreak.dragon_soul_burst"])
weapon_profile = SubResource("Resource_weapon_profile")
