[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponProfileDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponDamageDiceDef.cs" id="3_dice"]

[sub_resource type="Resource" id="Resource_one_handed_dice"]
script = ExtResource("3_dice")
