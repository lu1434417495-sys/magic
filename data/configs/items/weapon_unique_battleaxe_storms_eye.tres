two_handed_dice = SubResource("Resource_two_handed_dice")
properties_mode = 2
properties = Array[StringName]([&"versatile"])

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_axe_storms_eye_091"
base_item_id = &"weapon_type_battleaxe_base"
display_name = "风暴之眼"
description = "一柄仿佛由风暴云眼凝成的战斧。命中时引雷入刃，暴击时爆发雷鸣；装备者可施展裂云重劈，将敌人震退，推不动时追加雷鸣震击。"
is_stackable = false
base_price = 50000
buy_price = 50000
sell_price = 25000
sellable = true
max_stack = 1
tags = Array[StringName]([&"versatile", &"storms_eye", &"thunder", &"lightning"])
trait_ids = Array[StringName]([&"weapon.axe.storms_eye.lightning_edge", &"weapon.axe.storms_eye.thunder_rift", &"weapon.axe.storms_eye.cloudsplitter_heavy_chop"])
weapon_profile = SubResource("Resource_weapon_profile")
