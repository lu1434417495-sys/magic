[ext_resource type="Script" path="res://scripts/player/progression/AttributeModifier.cs" id="2_modifier"]

[sub_resource type="Resource" id="Resource_armor_ac_bonus"]
script = ExtResource("2_modifier")
attribute_id = &"armor_ac_bonus"
mode = &"flat"
value = 2
source_type = &"equipment"
source_id = &"armor_phoenix_rebirth_head"

[resource]
script = ExtResource("1_item")
item_id = &"armor_phoenix_rebirth_head"
display_name = "凤凰涅槃头冠"
description = "一顶由凤凰羽毛与余烬丝编织而成的辉煌头冠，头冠上镶嵌着一颗「凤凰之心」——一颗能够储存火焰并在死亡时释放的魔法宝石。头冠佩戴时，周围的温度会略微升高，仿佛穿戴者体内有一团火在燃烧。\n\n菲尼克斯在编织这头冠时，从一只真正的凤凰身上取下了三根尾羽。他说：\"凤凰不是普通的鸟，它是'永恒的火'——它死了，但它总会回来。\"\n\n这头冠使穿戴者受到的 fire damage 减半。且可以在死亡时触发「涅槃」——HP 降至 0 时，有 25% 概率不死亡，而是恢复至 25% 最大 HP 并释放一次「火焰爆发」（半径 3 格，3D10 fire，每场战斗一次）。穿齐凤凰重生7件后，套装会把火焰防护提升为免疫。菲尼克斯说：\"死亡不是终点，它只是'中场休息'。\""
icon = ""
is_stackable = false
base_price = 22000
buy_price = 22000
sell_price = 11000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"head", &"cloth", &"heavy_armor", &"phoenix_rebirth_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"equipment.phoenix_rebirth.head.fire_resistance", &"equipment.phoenix_rebirth.crown.nirvana"])
equipment_slot_ids = Array[String](["head"])
equipment_type_id = &"armor"
max_dex_bonus = 2
attribute_modifiers = Array[Resource]([SubResource("Resource_armor_ac_bonus")])
