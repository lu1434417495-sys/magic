[gd_resource type="Resource" script_class="ItemDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponProfileDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponDamageDiceDef.cs" id="3_dice"]

[sub_resource type="Resource" id="Resource_one_handed_dice"]
script = ExtResource("3_dice")
dice_count = 1
dice_sides = 6
flat_bonus = 2

[sub_resource type="Resource" id="Resource_weapon_profile"]
script = ExtResource("2_profile")
one_handed_dice = SubResource("Resource_one_handed_dice")

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_sword_rustoath_006"
base_item_id = &"weapon_type_shortsword_base"
display_name = "锈蚀之誓"
description = "一把覆满铁锈却仍旧锋利的短剑。"
is_stackable = false
base_price = 40000
buy_price = 40000
sell_price = 20000
sellable = true
max_stack = 1
tags = Array[StringName]([&"rustoath", &"rust", &"acid"])
trait_ids = Array[StringName]([&"weapon.sword.rustoath.rust_corrosion", &"weapon.sword.rustoath.armor_corrosion", &"weapon.sword.rustoath.rotten_blade", &"weapon.sword.rustoath.rust_powder_storm"])
weapon_profile = SubResource("Resource_weapon_profile")
