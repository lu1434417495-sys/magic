description = "一柄专为破甲碎骨而铸的沉重巨斧，斧刃厚重如锤，命中时会把护甲后的骨骼震裂。"
is_stackable = false
base_price = 48000
buy_price = 48000
sell_price = 24000
sellable = true
max_stack = 1
tags = Array[StringName]([&"bonecrusher", &"heavy", &"two_handed"])
trait_ids = Array[StringName]([&"weapon.axe.bonecrusher.armor_crushing_blow", &"weapon.axe.bonecrusher.bone_shatter", &"weapon.axe.bonecrusher.aftershock_fracture"])
