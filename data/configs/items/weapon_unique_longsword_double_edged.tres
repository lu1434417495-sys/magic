[gd_resource type="Resource" script_class="ItemDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponProfileDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponDamageDiceDef.cs" id="3_dice"]
[ext_resource type="Script" path="res://scripts/player/progression/AttributeModifier.cs" id="4_modifier"]

[sub_resource type="Resource" id="Resource_one_handed_dice"]
script = ExtResource("3_dice")
dice_count = 1
dice_sides = 8
flat_bonus = 3

[sub_resource type="Resource" id="Resource_two_handed_dice"]
script = ExtResource("3_dice")
dice_count = 1
dice_sides = 10
flat_bonus = 3

[sub_resource type="Resource" id="Resource_weapon_profile"]
script = ExtResource("2_profile")
one_handed_dice = SubResource("Resource_one_handed_dice")
two_handed_dice = SubResource("Resource_two_handed_dice")

[sub_resource type="Resource" id="Resource_no_guard_ac"]
script = ExtResource("4_modifier")
attribute_id = &"armor_ac_bonus"
mode = &"flat"
value = -2
source_type = &"equipment"
source_id = &"weapon_unique_sword_double_edged_263"

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_sword_double_edged_263"
base_item_id = &"weapon_type_longsword_base"
display_name = "双面刃"
description = "一柄两侧都开刃的长剑，剑脊像被撕开的镜面；越是追求双重斩击，越难留下防守余地。"
is_stackable = false
base_price = 65000
buy_price = 65000
sell_price = 32500
sellable = true
max_stack = 1
tags = Array[StringName]([&"double_edged", &"sword", &"melee"])
trait_ids = Array[StringName]([&"weapon.sword.double_edged.twin_attack", &"weapon.sword.double_edged.no_guard", &"weapon.sword.double_edged.paradox_dance", &"weapon.sword.double_edged.single_edge"])
attribute_modifiers = Array[Resource]([SubResource("Resource_no_guard_ac")])
weapon_profile = SubResource("Resource_weapon_profile")
