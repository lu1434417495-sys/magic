[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]

[resource]
script = ExtResource("1_item")
item_id = &"acc_phoenix_rebirth_necklace"
display_name = "凤凰重生涅槃之心项链"
description = "一条由凤凰心金与火焰水晶编织而成的项链，吊坠是一颗涅槃之心。\n\n每日一次可消耗1 AP释放「涅槃之火」：自身或1格内一个存活友方恢复3D8 HP，并移除至多一个当前状态系统认定为可驱散的有害魔法；不可驱散状态不受影响。当前状态系统尚未独立区分disease、curse与legendary，因此不额外伪造该筛选。"
icon = ""
is_stackable = false
base_price = 10000
buy_price = 10000
sell_price = 5000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"accessory", &"necklace", &"phoenix_rebirth_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"equipment.phoenix_rebirth.necklace.nirvana_fire"])
equipment_slot_ids = Array[String](["necklace"])
equipment_type_id = &"accessory"
attribute_modifiers = Array[Resource]([])
