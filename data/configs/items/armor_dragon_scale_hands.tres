[gd_resource type="Resource" script_class="ItemDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/progression/AttributeModifier.cs" id="2_modifier"]

[sub_resource type="Resource" id="Resource_armor_ac_bonus"]
script = ExtResource("2_modifier")
attribute_id = &"armor_ac_bonus"
mode = &"flat"
value = 1
source_type = &"equipment"
source_id = &"armor_dragon_scale_hands"

[sub_resource type="Resource" id="Resource_attack_bonus"]
script = ExtResource("2_modifier")
attribute_id = &"attack_bonus"
mode = &"flat"
value = 2
source_type = &"equipment"
source_id = &"armor_dragon_scale_hands"

[resource]
script = ExtResource("1_item")
item_id = &"armor_dragon_scale_hands"
display_name = "龙鳞护手"
description = "一对覆盖着龙爪鳞片的重型护手，手背处各嵌有一片龙逆鳞。握紧拳头时，逆鳞会微微竖起，释放出龙威的残余气息。\n\n装备者攻击检定 +2；每次近战武器命中 dragon 类型生物时，该段主直接伤害额外 +1D4（伤害标签继承主武器伤害），重复攻击与随机链逐段独立触发。集齐龙鳞铠甲套装可唤醒更强的屠龙之力。"
icon = ""
is_stackable = false
base_price = 16000
buy_price = 16000
sell_price = 8000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"hands", &"metal", &"heavy_armor", &"dragon_scale_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"armor.dragon_scale.hands.dragon_rend"])
equipment_slot_ids = Array[String](["hands"])
equipment_type_id = &"armor"
attribute_modifiers = Array[Resource]([SubResource("Resource_armor_ac_bonus"), SubResource("Resource_attack_bonus")])
