[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_battleaxe_lumberjack_383"
base_item_id = &"weapon_type_battleaxe_base"
display_name = "伐木工之斧"
description = "一柄宽刃沉重的传奇战斧。命中存活目标后留下 60TU 劈痕，继续攻击自己的劈痕目标时获得 +1 命中并追加 1D4 挥砍伤害；对植物额外造成 2D6 挥砍伤害，砍倒已有自身劈痕的目标时可封顶恢复 1 AP。"
is_stackable = false
base_price = 38000
buy_price = 38000
sell_price = 19000
sellable = true
max_stack = 1
tags = Array[StringName]([&"versatile", &"lumberjack_axe", &"lumberjack", &"plant_slayer"])
trait_ids = Array[StringName]([&"weapon.axe.lumberjack.chopping_rhythm", &"weapon.axe.lumberjack.plant_slayer", &"weapon.axe.lumberjack.felling_momentum"])
weapon_profile = SubResource("Resource_weapon_profile")
