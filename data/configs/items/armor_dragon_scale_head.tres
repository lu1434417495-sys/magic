[resource]
script = ExtResource("1_item")
item_id = &"armor_dragon_scale_head"
display_name = "龙鳞头盔"
description = "一顶由五色龙鳞拼缀而成的重型头盔，鳞片中仍残留着龙威的气息。\n\n装备者受到的 fire 伤害减半，对 dragon 类型生物的攻击检定 +2。集齐龙鳞铠甲套装可唤醒更强的屠龙之力。"
icon = ""
is_stackable = false
base_price = 20000
buy_price = 20000
sell_price = 10000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"head", &"metal", &"heavy_armor", &"dragon_scale_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"armor.dragon_scale.head.fire_resistance", &"armor.dragon_scale.head.dragon_slayer_focus"])
equipment_slot_ids = Array[String](["head"])
equipment_type_id = &"armor"
