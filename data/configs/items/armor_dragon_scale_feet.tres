mode = &"flat"
value = 1
source_type = &"equipment"
source_id = &"armor_dragon_scale_feet"

[resource]
script = ExtResource("1_item")
item_id = &"armor_dragon_scale_feet"
display_name = "龙鳞胫甲"
description = "一双由龙骨与龙鳞锻铸而成的沉重金靴，靴底刻有龙爪纹路。\n\n装备者对 frightened 与 dragon_frightful_presence 豁免检定 +3，并免疫龙威（dragon_frightful_presence）。集齐龙鳞铠甲套装可唤醒更强的屠龙之力。"
icon = ""
is_stackable = false
base_price = 16000
buy_price = 16000
sell_price = 8000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"feet", &"metal", &"heavy_armor", &"dragon_scale_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"armor.dragon_scale.feet.fear_ward"])
equipment_slot_ids = Array[String](["feet"])
equipment_type_id = &"armor"
attribute_modifiers = Array[Resource]([SubResource("Resource_armor_ac_bonus")])
