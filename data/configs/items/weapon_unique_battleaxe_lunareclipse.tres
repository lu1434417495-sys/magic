two_handed_dice = SubResource("Resource_two_handed_dice")
properties_mode = 2
properties = Array[StringName]([&"versatile"])

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_battleaxe_lunareclipse"
base_item_id = &"weapon_type_battleaxe_base"
display_name = "月蚀"
description = "一柄银白斧刃上永远带着缺月阴影的战斧。真实武器伤害会积蓄月相，三层后爆发盈月裁断；装备者可施展月蚀影步，在未穿重甲时闪现并短暂提升闪避。"
is_stackable = false
base_price = 56000
buy_price = 56000
sell_price = 28000
sellable = true
max_stack = 1
tags = Array[StringName]([&"versatile", &"lunareclipse", &"moon", &"radiant"])
trait_ids = Array[StringName]([&"weapon.battleaxe.lunareclipse.moon_phase_cycle", &"weapon.battleaxe.lunareclipse.full_moon_judgment", &"weapon.battleaxe.lunareclipse.eclipse_shadowstep"])
weapon_profile = SubResource("Resource_weapon_profile")
