[gd_resource type="Resource" script_class="ItemDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponProfileDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponDamageDiceDef.cs" id="3_dice"]

[sub_resource type="Resource" id="Resource_two_handed_dice"]
script = ExtResource("3_dice")
dice_count = 1
dice_sides = 10
flat_bonus = 3

[sub_resource type="Resource" id="Resource_weapon_profile"]
script = ExtResource("2_profile")
weapon_type_id = &"halberd"
training_group = &"martial"
range_type = &"melee"
family = &"polearm"
damage_tag = &"physical_slash"
attack_range = 2
two_handed_dice = SubResource("Resource_two_handed_dice")
properties_mode = 1
properties = Array[StringName]([&"two_handed", &"heavy", &"reach"])

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_polearm_rock_halberd_148"
base_item_id = &"weapon_type_halberd_base"
display_name = "岩石之戟"
description = "一柄仿佛由活化石锻造而成的长戟，命中时将石化能量传递给目标。"
is_stackable = false
base_price = 45000
buy_price = 45000
sell_price = 22500
sellable = true
max_stack = 1
tags = Array[StringName]([&"rock_halberd", &"halberd", &"polearm", &"petrification", &"heavy", &"reach"])
trait_ids = Array[StringName]([&"weapon.polearm.rock_halberd.stone_touch", &"weapon.polearm.rock_halberd.complete_petrification", &"weapon.polearm.rock_halberd.stone_tears"])
weapon_profile = SubResource("Resource_weapon_profile")
