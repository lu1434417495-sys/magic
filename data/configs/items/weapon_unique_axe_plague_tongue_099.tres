base_price = 48000
buy_price = 48000
sell_price = 24000
sellable = true
max_stack = 1
tags = Array[StringName]([&"versatile", &"plague_tongue", &"disease", &"poison"])
trait_ids = Array[StringName]([&"weapon.axe.plague_tongue.poison_touch_damage", &"weapon.axe.plague_tongue.axe_fever", &"weapon.axe.plague_tongue.plague_spread", &"weapon.axe.plague_tongue.immune_carrier"])
