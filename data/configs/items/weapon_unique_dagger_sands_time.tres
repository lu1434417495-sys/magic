[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_sands_time_480"
base_item_id = &"weapon_type_dagger_base"
display_name = "时间之沙"
description = "一柄金色沙漏形匕首，刃内流动的细沙会扰乱持有者与敌人的时间节律。"
is_stackable = false
base_price = 85000
buy_price = 85000
sell_price = 42500
sellable = true
max_stack = 1
tags = Array[StringName]([&"sands_time", &"time", &"exotic"])
trait_ids = Array[StringName]([&"weapon.exotic.sands_time.time_acceleration", &"weapon.exotic.sands_time.time_deceleration", &"weapon.exotic.sands_time.time_dislocation"])
weapon_profile = SubResource("Resource_weapon_profile")
