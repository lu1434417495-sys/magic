[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_greataxe_executioner_384"
base_item_id = &"weapon_type_greataxe_base"
display_name = "处刑者之斧"
description = "一柄仿佛由死亡本身锻造的沉重巨斧。它能向近身敌人宣告死刑，但每一次未能完成的判决都会反噬持有者。"
is_stackable = false
base_price = 55000
buy_price = 55000
sell_price = 27500
sellable = true
max_stack = 1
tags = Array[StringName]([&"executioner_axe", &"executioner", &"heavy", &"two_handed"])
trait_ids = Array[StringName]([&"weapon.axe.executioner.execution", &"weapon.axe.executioner.death_sentence", &"weapon.axe.executioner.self_execution"])
weapon_profile = SubResource("Resource_weapon_profile")
