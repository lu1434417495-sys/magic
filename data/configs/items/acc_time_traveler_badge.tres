[resource]
script = ExtResource("1_item")
item_id = &"acc_time_traveler_badge"
display_name = "时间旅者徽章"
description = "一枚由时间金与时空石铸造的徽章，徽章上刻着一个沙漏和一个箭头——时间旅者的标志。徽章背面刻着一行小字：「时间是环，旅行者即编织者。」这枚徽章是时间公会的信物，拥有它意味着你已被时间认可。"
icon = ""
is_stackable = false
base_price = 9000
buy_price = 9000
sell_price = 4500
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"accessory", &"badge", &"time_traveler_set"])
