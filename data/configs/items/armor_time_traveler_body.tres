[sub_resource type="Resource" id="Resource_dodge_bonus"]
script = ExtResource("2_modifier")
attribute_id = &"dodge_bonus"
mode = &"flat"
value = 2
source_type = &"equipment"
source_id = &"armor_time_traveler_body"

[resource]
script = ExtResource("1_item")
item_id = &"armor_time_traveler_body"
display_name = "时间旅者长袍"
description = "一件由时间结晶与轮回丝编织而成的奇异长袍，长袍表面不断有钟表指针在旋转。这件长袍没有固定的颜色——它会根据当前的时间变化：早晨是金色，中午是白色，傍晚是红色，夜晚是黑色。在特殊的时间点（午夜、正午、黎明、黄昏），长袍会发出微弱的光芒。\n\n克罗诺斯在编织这件长袍时，将所有的时间都编入了丝线。他说：\"这件长袍不只是衣服，它是'时间的容器'——让我穿着所有的时间。\"\n\n克罗诺斯说：\"时间不是只能用来预知，它也可以用来操控——加速盟友，减速敌人。\""
icon = ""
is_stackable = false
base_price = 45000
buy_price = 45000
sell_price = 22500
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"body", &"cloth", &"light_armor", &"time_traveler_set"])
trait_ids = Array[StringName]([])
equipment_slot_ids = Array[String](["body"])
equipment_type_id = &"armor"
max_dex_bonus = 6
attribute_modifiers = Array[Resource]([SubResource("Resource_armor_ac_bonus"), SubResource("Resource_dodge_bonus")])
