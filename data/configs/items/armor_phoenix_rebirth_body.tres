[gd_resource type="Resource" script_class="ItemDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/progression/AttributeModifier.cs" id="2_modifier"]

[sub_resource type="Resource" id="Resource_armor_ac_bonus"]
script = ExtResource("2_modifier")
attribute_id = &"armor_ac_bonus"
mode = &"flat"
value = 6
source_type = &"equipment"
source_id = &"armor_phoenix_rebirth_body"

[sub_resource type="Resource" id="Resource_hp_max"]
script = ExtResource("2_modifier")
attribute_id = &"hp_max"
mode = &"flat"
value = 20
source_type = &"equipment"
source_id = &"armor_phoenix_rebirth_body"

[resource]
script = ExtResource("1_item")
item_id = &"armor_phoenix_rebirth_body"
display_name = "凤凰涅槃板甲"
description = "一副由凤凰羽毛与余烬丝编织而成的辉煌板甲，板甲表面不断有微弱的火焰在流动。在战斗中，火焰会变得更加旺盛——燃烧得越猛烈，板甲的防御力越高。\n\n外部非自身、非装备能力生成的正 fire 原始伤害会使板甲获得1层燃烧并刷新至60 TU；最多3层，每层AC+1。可消耗2 AP释放火盾，每个世界日一次、任意燃烧层数均可使用：清除全部燃烧并获得持续60 TU的凤凰火盾（AC+3）；火盾期间每次成功近战命中后，攻击者受到2D6 fire，无豁免。"
icon = ""
is_stackable = false
base_price = 37000
buy_price = 37000
sell_price = 18500
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"body", &"cloth", &"heavy_armor", &"phoenix_rebirth_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"equipment.phoenix_rebirth.body.burning_plate"])
equipment_slot_ids = Array[String](["body"])
equipment_type_id = &"armor"
max_dex_bonus = 2
attribute_modifiers = Array[Resource]([SubResource("Resource_armor_ac_bonus"), SubResource("Resource_hp_max")])
