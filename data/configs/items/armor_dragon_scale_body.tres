[gd_resource type="Resource" script_class="ItemDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/progression/AttributeModifier.cs" id="2_modifier"]

[sub_resource type="Resource" id="Resource_armor_ac_bonus"]
script = ExtResource("2_modifier")
attribute_id = &"armor_ac_bonus"
mode = &"flat"
value = 7
source_type = &"equipment"
source_id = &"armor_dragon_scale_body"

[sub_resource type="Resource" id="Resource_hp_max"]
script = ExtResource("2_modifier")
attribute_id = &"hp_max"
mode = &"flat"
value = 10
source_type = &"equipment"
source_id = &"armor_dragon_scale_body"

[resource]
script = ExtResource("1_item")
item_id = &"armor_dragon_scale_body"
display_name = "龙鳞胸甲"
description = "一副由五条不同龙种的鳞甲拼接而成的全身胸甲，每一种龙鳞都保留了其原主的元素抗性。\n\n装备者受到的 fire、freeze、lightning 伤害减半，最大生命 +10。集齐龙鳞铠甲套装可唤醒更强的屠龙之力。"
icon = ""
is_stackable = false
base_price = 36000
buy_price = 36000
sell_price = 18000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"armor", &"body", &"metal", &"heavy_armor", &"dragon_scale_set", &"world_unique_equipment"])
trait_ids = Array[StringName]([&"armor.dragon_scale.body.element_resistance"])
equipment_slot_ids = Array[String](["body"])
equipment_type_id = &"armor"
max_dex_bonus = 1
attribute_modifiers = Array[Resource]([SubResource("Resource_armor_ac_bonus"), SubResource("Resource_hp_max")])
