[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]

[resource]
script = ExtResource("1_item")
item_id = &"acc_time_traveler_necklace"
display_name = "时间旅者时间之核项链"
description = "一条由时间金与时空水晶编织而成的项链，吊坠是一颗时间之核——一颗由纯粹时间凝结的核心。核心内部不断有微型时间在流动和倒转，如同一个永恒的时间循环。据说这颗核心来自时间之神的心脏，他在创造时间时，将自己的一部分力量封印在了其中。\n\n这条项链是时间旅者在「时间之源」中，从时间之神的祭坛上取出的。他说：\"这颗核心承载了我的时间之力。它让我能够穿越时间，也让我能够理解时间的本质。\""
icon = ""
is_stackable = false
base_price = 10000
buy_price = 10000
sell_price = 5000
sellable = true
max_stack = 1
item_category = &"equipment"
tags = Array[StringName]([&"accessory", &"necklace", &"time_traveler_set"])
trait_ids = Array[StringName]([])
equipment_slot_ids = Array[String](["necklace"])
equipment_type_id = &"accessory"
attribute_modifiers = Array[Resource]([])
