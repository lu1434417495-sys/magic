[gd_resource type="Resource" script_class="ItemDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player/warehouse/ItemDef.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponProfileDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/warehouse/WeaponDamageDiceDef.cs" id="3_dice"]

[sub_resource type="Resource" id="Resource_two_handed_dice"]
script = ExtResource("3_dice")
dice_count = 1
dice_sides = 12
flat_bonus = 2

[sub_resource type="Resource" id="Resource_weapon_profile"]
script = ExtResource("2_profile")
two_handed_dice = SubResource("Resource_two_handed_dice")
properties_mode = 2
properties = Array[StringName]([&"heavy"])

[resource]
script = ExtResource("1_item")
item_id = &"weapon_unique_axe_starfragment_100"
base_item_id = &"weapon_type_greataxe_base"
display_name = "星辰碎片"
description = "一柄嵌有星辰碎片的重型巨斧，斧刃会在夜色中映出细碎星辉。"
is_stackable = false
base_price = 75000
buy_price = 75000
sell_price = 37500
sellable = true
max_stack = 1
tags = Array[StringName]([&"heavy", &"starfragment", &"force", &"astral"])
trait_ids = Array[StringName]([&"weapon.axe.starfragment.stardust_touch", &"weapon.axe.starfragment.starburst", &"weapon.axe.starfragment.cosmic_dread"])
weapon_profile = SubResource("Resource_weapon_profile")
