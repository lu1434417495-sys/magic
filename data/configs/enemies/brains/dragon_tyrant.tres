[ext_resource type="Script" path="res://scripts/enemies/EnemyAiTransitionConditionDef.cs" id="10_transition_condition"]

[sub_resource type="Resource" id="Action_engage_breath"]
script = ExtResource("3_ground")
action_id = &"dragon_breath_sweep"
score_bucket_id = &"dragon_offense"
skill_ids = Array[StringName]([&"dragon_breath_fire_cone", &"dragon_breath_fire_line", &"dragon_breath_freeze_cone", &"dragon_breath_poison_cone", &"dragon_breath_acid_line", &"dragon_breath_lightning_line"])
minimum_hit_count = 2
desired_min_distance = 2
desired_max_distance = 3
distance_reference = &"target_coord"

[sub_resource type="Resource" id="Action_engage_move"]
script = ExtResource("5_move")
action_id = &"dragon_close_in"
target_selector = &"nearest_enemy"
desired_min_distance = 1
desired_max_distance = 2

[sub_resource type="Resource" id="Action_wait"]
script = ExtResource("6_wait")
action_id = &"dragon_wait"

[sub_resource type="Resource" id="Slot_engage_ground"]
script = ExtResource("8_slot")
