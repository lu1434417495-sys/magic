[gd_resource type="Resource" script_class="EnemyAiBrainDef" format=3]

[ext_resource type="Script" path="res://scripts/enemies/EnemyAiBrainDef.cs" id="1_brain"]
[ext_resource type="Script" path="res://scripts/enemies/EnemyAiStateDef.cs" id="2_state"]
[ext_resource type="Script" path="res://scripts/enemies/actions/UseGroundSkillAction.cs" id="3_ground"]
