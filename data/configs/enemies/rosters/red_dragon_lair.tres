[gd_resource type="Resource" script_class="WildEncounterRosterDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/enemies/WildEncounterRosterDef.cs" id="1_roster"]
[ext_resource type="Script" path="res://scripts/enemies/WildEncounterRosterStageDef.cs" id="2_stage"]
[ext_resource type="Script" path="res://scripts/enemies/WildEncounterRosterUnitEntryDef.cs" id="3_entry"]

[sub_resource type="Resource" id="Resource_red_dragon"]
