[resource]
script = ExtResource("1_scenario")
scenario_id = &"tuning_mage_kite_val"
display_name = "Tuning Validation: Mage vs 3 Melee"
description = "Held-out validation arena for the mage tuning space: 1 mage vs 3 melee (HP 120) on an 18x10 map. Different force composition / map from tuning_mage_kite — used only to check the evolved genome generalises (overfit guard), never in the CMA objective."
map_size = Vector2i(18, 10)
terrain_profile_id = &"default"
use_formal_terrain_generation = false
ally_units = Array[Resource]([SubResource("Resource_melee_0"), SubResource("Resource_melee_1"), SubResource("Resource_melee_2")])
enemy_units = Array[Resource]([SubResource("Resource_mage")])
timeline_ticks_per_step = 1
tu_per_tick = 5
max_iterations = 900
manual_policy = &"ai"
seeds = PackedInt32Array(201, 202)
