control_mode = &"ai"
ai_brain_id = &"mage_controller"
ai_state_id = &"pressure"
coord = Vector2i(1, 5)
current_hp = 44
current_mp = 1000
current_stamina = 20
current_ap = 2
action_threshold = 120
unlocked_combat_resource_ids = Array[StringName]([&"mp"])
base_attributes = {
"strength": 8,
"agility": 12,
"constitution": 12,
"perception": 12,
"intelligence": 18,
"willpower": 14
}
attribute_overrides = {
"hp_max": 44,
"mp_max": 1000,
"stamina_max": 20,
"action_points": 2,
"attack_bonus": 4,
"armor_ac_bonus": 2
}
skill_ids = Array[StringName]([&"mage_fireball", &"mage_blink"])
