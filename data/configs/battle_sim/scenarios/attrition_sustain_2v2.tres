[sub_resource type="Resource" id="Resource_player_w0"]
script = ExtResource("2_unit")
unit_id = &"attr_player_w0"
display_name = "玩家战士0"
faction_id = &"player"
control_mode = &"ai"
ai_brain_id = &"melee_aggressor"
ai_state_id = &"engage"
coord = Vector2i(10, 3)
current_hp = 80
current_stamina = 8
current_ap = 2
action_threshold = 110
base_attributes = {
"strength": 14,
"agility": 12,
"constitution": 14,
"perception": 10,
"intelligence": 8,
"willpower": 10
}
attribute_overrides = {
"hp_max": 80,
"stamina_max": 8,
"action_points": 2,
"attack_bonus": 6,
"armor_ac_bonus": 2
}
skill_ids = Array[StringName]([&"charge", &"warrior_heavy_strike"])
skill_level_map = {
"charge": 1,
"warrior_heavy_strike": 1
}

