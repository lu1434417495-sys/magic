[resource]
script = ExtResource("1_scenario")
scenario_id = &"attrition_sustain_2v2"
display_name = "Attrition Sustain (Melee Mirror 2v2)"
description = "资源吃紧的近战消耗战：双方各 2 名战士(stamina_max 8, charge/heavy_strike 耗耐力)，小地图(14x8)、低 AC 保证近战命中与出结果，无法师/无风筝以避免僵局。设计为耐力续航(B 组 stamina)与自身生存投影(A 组)评分有梯度；镜像编成 => 基线对基线约 50%，给被调方(player)留出调参空间。仅作调参场景，非平衡基线。注意：本场景只覆盖耐力续航，MP 续航需另建一个不会风筝的法师场景。使用前需 COUNT>=20 复核胜率与僵局率(ended 比例)。"
map_size = Vector2i(14, 8)
terrain_profile_id = &"default"
use_formal_terrain_generation = false
ally_units = Array[Resource]([SubResource("Resource_player_w0"), SubResource("Resource_player_w1")])
enemy_units = Array[Resource]([SubResource("Resource_hostile_w0"), SubResource("Resource_hostile_w1")])
timeline_ticks_per_step = 1
tu_per_tick = 5
max_iterations = 1000
manual_policy = &"ai"
seeds = PackedInt32Array(101, 102, 103)
