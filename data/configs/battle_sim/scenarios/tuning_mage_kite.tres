[resource]
script = ExtResource("1_scenario")
scenario_id = &"tuning_mage_kite"
display_name = "Tuning: Mage Kite vs Melee"
description = "1 mage (mage_controller) vs 2 melee chasers (melee_aggressor). Designed so a good min_survival_margin_gain_to_escape lets the mage commit to fireballs and win, while the broken always-escape value sends it into the blink limit cycle (stalemate). Tuning arena only — not a balance baseline."
map_size = Vector2i(16, 8)
terrain_profile_id = &"default"
use_formal_terrain_generation = false
ally_units = Array[Resource]([SubResource("Resource_melee_0"), SubResource("Resource_melee_1")])
enemy_units = Array[Resource]([SubResource("Resource_mage")])
timeline_ticks_per_step = 1
tu_per_tick = 5
max_iterations = 800
manual_policy = &"ai"
seeds = PackedInt32Array(101, 102)
