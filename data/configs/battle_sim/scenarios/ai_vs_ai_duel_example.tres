current_hp = 42
current_mp = 20
current_stamina = 120
current_ap = 2
current_move_points = 2
base_attributes = {
"strength": 10,
"agility": 12,
"constitution": 12,
"perception": 14,
"intelligence": 10,
"willpower": 10
}
attribute_overrides = {
"hp_max": 42,
"mp_max": 20,
"stamina_max": 120,
"action_points": 2,
"attack_bonus": 6,
"armor_ac_bonus": 4
}
skill_ids = Array[StringName]([&"basic_attack", &"archer_suppressive_fire", &"archer_pinning_shot"])
skill_level_map = {
"basic_attack": 1,
"archer_suppressive_fire": 1,
"archer_pinning_shot": 1
}
weapon_projection = {
"weapon_profile_kind": "equipped",
"weapon_item_id": "ash_longbow",
"weapon_profile_type_id": "longbow",
"weapon_range_type": "ranged",
"weapon_family": "bow",
"weapon_current_grip": "two_handed",
"weapon_attack_range": 4,
"weapon_one_handed_dice": {
"dice_count": 0,
"dice_sides": 0
},
"weapon_two_handed_dice": {
"dice_count": 1,
"dice_sides": 8
},
"weapon_is_versatile": false,
"weapon_uses_two_hands": true,
"weapon_physical_damage_tag": "physical_pierce"
}

[resource]
script = ExtResource("1_scenario")
scenario_id = &"ai_vs_ai_duel_example"
display_name = "AI vs AI Duel Example"
description = "用于验证 player/hostile 双方都由 AI 驱动时的整场战斗模拟。"
map_size = Vector2i(6, 3)
ally_units = Array[Resource]([SubResource("Resource_player_vanguard")])
enemy_units = Array[Resource]([SubResource("Resource_enemy_harrier")])
timeline_ticks_per_step = 1
tu_per_tick = 5
max_iterations = 400
seeds = PackedInt32Array(301, 302)
