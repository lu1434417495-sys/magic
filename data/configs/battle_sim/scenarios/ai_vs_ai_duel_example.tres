[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/systems/battle/sim/BattleSimScenarioDef.cs" id="1_scenario"]
[ext_resource type="Script" path="res://scripts/systems/battle/sim/BattleSimUnitSpec.cs" id="2_unit"]

[sub_resource type="Resource" id="Resource_player_vanguard"]
script = ExtResource("2_unit")
unit_id = &"player_vanguard_ai"
display_name = "先锋斗士"
faction_id = &"player"
control_mode = &"ai"
ai_brain_id = &"melee_aggressor"
ai_state_id = &"engage"
coord = Vector2i(0, 1)
current_hp = 48
current_stamina = 120
current_ap = 2
current_move_points = 2
base_attributes = {
"strength": 14,
"agility": 12,
"constitution": 14,
"perception": 10,
"intelligence": 8,
"willpower": 10
}
attribute_overrides = {
"hp_max": 48,
"stamina_max": 120,
"action_points": 2,
"attack_bonus": 6,
"armor_ac_bonus": 6
}
skill_ids = Array[StringName]([&"basic_attack", &"charge", &"warrior_heavy_strike"])
skill_level_map = {
"basic_attack": 1,
"charge": 1,
"warrior_heavy_strike": 1
}
weapon_projection = {
"weapon_profile_kind": "equipped",
"weapon_item_id": "steel_longsword",
"weapon_profile_type_id": "longsword",
"weapon_range_type": "melee",
"weapon_family": "sword",
"weapon_current_grip": "one_handed",
"weapon_attack_range": 1,
"weapon_one_handed_dice": {
"dice_count": 1,
"dice_sides": 8
},
"weapon_two_handed_dice": {
"dice_count": 1,
"dice_sides": 10
},
"weapon_is_versatile": true,
"weapon_uses_two_hands": false,
"weapon_physical_damage_tag": "physical_slash"
}

[sub_resource type="Resource" id="Resource_enemy_harrier"]
script = ExtResource("2_unit")
unit_id = &"enemy_harrier_ai"
display_name = "猎压弓手"
faction_id = &"hostile"
control_mode = &"ai"
ai_brain_id = &"ranged_suppressor"
