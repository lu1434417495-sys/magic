[ext_resource type="Script" path="res://scripts/player/progression/TraitDef.cs" id="1_trait"]

[resource]
script = ExtResource("1_trait")
trait_id = &"weapon.axe.executioner.self_execution"
display_name = "自我处刑"
description = "若死亡判决目标在完整结算后仍存活，或判决在 60TU 内未被使用，持有者进行 DC14 意志检定；失败受到 2D12+2 挥砍伤害。该伤害可以致死。"
categories = Array[StringName]([&"weapon_feat"])
