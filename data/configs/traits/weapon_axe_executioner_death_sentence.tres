[gd_resource type="Resource" script_class="TraitDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/TraitDef.cs" id="1_trait"]

[resource]
script = ExtResource("1_trait")
trait_id = &"weapon.axe.executioner.death_sentence"
display_name = "死亡判决"
description = "获得 1 级装备技能死亡判决：对相邻敌人施加 60TU 判决，消耗 1AP 与 60 体力，冷却 300TU。下一次成功命中将结算判决并消费标记。"
categories = Array[StringName]([&"weapon_feat"])
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
effect_type = &"equipment_ability"
trigger_type = &"passive"
stack_policy = &"stack_by_instance"
charge_scope = &"none"
charge_reset_timing = &"none"
attribute_modifiers = Array[Resource]([])
roll_value_schema = Array[Resource]([])
