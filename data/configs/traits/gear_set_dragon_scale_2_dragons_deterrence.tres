[gd_resource type="Resource" script_class="TraitDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/TraitDef.cs" id="1_trait"]
[ext_resource type="Script" path="res://scripts/player/progression/TraitDamageResistanceEntryDef.cs" id="2_resistance"]
[ext_resource type="Script" path="res://scripts/player/progression/TraitSaveTagBonusEntryDef.cs" id="3_save_tag_bonus"]

[sub_resource type="Resource" id="Resistance_fire_half"]
script = ExtResource("2_resistance")
damage_tag = &"fire"
mitigation_tier = &"half"

[sub_resource type="Resource" id="SaveTagBonus_frightened"]
script = ExtResource("3_save_tag_bonus")
save_tag = &"frightened"
bonus = 3
stack_mode = &"add"

[sub_resource type="Resource" id="SaveTagBonus_dragon_frightful_presence"]
script = ExtResource("3_save_tag_bonus")
save_tag = &"dragon_frightful_presence"
bonus = 3
stack_mode = &"add"

[resource]
script = ExtResource("1_trait")
trait_id = &"gear_set.dragon_scale.2.dragons_deterrence"
display_name = "龙之威慑"
description = "龙鳞铠甲套装2件效果：fire 伤害减半；对 frightened 与 dragon_frightful_presence 豁免检定 +3（与龙鳞胫甲按 add 叠加）；免疫龙威（dragon_frightful_presence）。"
categories = Array[StringName]([&"gear_set_bonus"])
allowed_source_kinds = Array[StringName]([&"gear_set_threshold"])
effect_type = &"equipment_ability"
trigger_type = &"passive"
stack_policy = &"unique_by_trait"
charge_scope = &"none"
charge_reset_timing = &"none"
attribute_modifiers = Array[Resource]([])
save_advantage_tags = Array[StringName]([])
save_immunity_tags = Array[StringName]([&"dragon_frightful_presence"])
damage_resistance_entries = Array[Resource]([SubResource("Resistance_fire_half")])
save_bonus_entries = Array[Resource]([])
save_tag_bonus_entries = Array[Resource]([SubResource("SaveTagBonus_frightened"), SubResource("SaveTagBonus_dragon_frightful_presence")])
roll_value_schema = Array[Resource]([])
