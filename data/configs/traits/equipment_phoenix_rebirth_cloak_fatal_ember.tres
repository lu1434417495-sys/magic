[ext_resource type="Script" path="res://scripts/player/progression/TraitDef.cs" id="1_trait"]

[resource]
script = ExtResource("1_trait")
trait_id = &"equipment.phoenix_rebirth.cloak.fatal_ember"
display_name = "凤凰余烬与怒火"
description = "每场战斗一次，普通致死伤害有25%概率恢复1D12 HP，正式尝试即消耗该次数。另每场战斗一次：第一次因外部非自身、非装备能力生成的正原始伤害从高于50%生命降至不高于50%时，对自身半径1格内所有敌人造成2D6 fire，无豁免；无敌人也消耗。致死拦截恢复后的跨阈值同样触发。"
categories = Array[StringName]([&"equipment_ability", &"phoenix_rebirth"])
allowed_source_kinds = Array[StringName]([&"equipment_fixed"])
effect_type = &"equipment_ability"
trigger_type = &"passive"
