{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic:content-schema:skills:v1",
  "title": "Magic skill JSON authoring schema (stage 1a pilot)",
  "description": "Current stage-1a skill import contract. It covers the committed pilot fields and the layered_barrier effect payload only; it is not the final full-skill-domain schema.",
  "$ref": "#/$defs/SkillJsonDocumentDto",
  "$defs": {
    "CombatEffectJsonDto": {
      "oneOf": [
        {
          "$ref": "#/$defs/CombatEffectJsonDto__layered_barrier"
        }
      ],
      "discriminator": {
        "propertyName": "effect_type",
        "mapping": {
          "layered_barrier": "#/$defs/CombatEffectJsonDto__layered_barrier"
        }
      }
    },
    "CombatEffectJsonDto__layered_barrier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_tu": {
          "type": "integer"
        },
        "effect_type": {
          "type": "string",
          "const": "layered_barrier"
        },
        "max_skill_level": {
          "type": "integer"
        },
        "min_skill_level": {
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/LayeredBarrierEffectPayloadJsonDto"
        },
        "power": {
          "type": "integer"
        }
      },
      "required": [
        "effect_type",
        "payload"
      ]
    },
    "CombatSkillJsonDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ap_cost": {
          "type": "integer"
        },
        "area_pattern": {
          "type": "string",
          "enum": [
            "single",
            "self",
            "diamond",
            "square",
            "line"
          ]
        },
        "cooldown_tu": {
          "type": "integer"
        },
        "effect_defs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CombatEffectJsonDto"
          }
        },
        "level_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SkillLevelOverrideJsonDto"
          }
        },
        "mp_cost": {
          "type": "integer"
        },
        "range_pattern": {
          "type": "string",
          "enum": [
            "single",
            "diamond",
            "square",
            "line"
          ]
        },
        "range_value": {
          "type": "integer"
        },
        "skill_id": {
          "type": "string"
        },
        "target_mode": {
          "type": "string",
          "enum": [
            "unit",
            "ground"
          ]
        },
        "target_team_filter": {
          "type": "string",
          "enum": [
            "self",
            "ally",
            "enemy",
            "any"
          ]
        }
      },
      "required": [
        "skill_id"
      ]
    },
    "CombatSkillJsonDto__partial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ap_cost": {
          "type": "integer"
        },
        "area_pattern": {
          "type": "string",
          "enum": [
            "single",
            "self",
            "diamond",
            "square",
            "line"
          ]
        },
        "cooldown_tu": {
          "type": "integer"
        },
        "effect_defs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CombatEffectJsonDto"
          }
        },
        "level_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SkillLevelOverrideJsonDto__partial"
          }
        },
        "mp_cost": {
          "type": "integer"
        },
        "range_pattern": {
          "type": "string",
          "enum": [
            "single",
            "diamond",
            "square",
            "line"
          ]
        },
        "range_value": {
          "type": "integer"
        },
        "skill_id": {
          "type": "string"
        },
        "target_mode": {
          "type": "string",
          "enum": [
            "unit",
            "ground"
          ]
        },
        "target_team_filter": {
          "type": "string",
          "enum": [
            "self",
            "ally",
            "enemy",
            "any"
          ]
        }
      }
    },
    "LayeredBarrierEffectPayloadJsonDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "area_pattern": {
          "type": "string",
          "enum": [
            "single",
            "self",
            "diamond",
            "square",
            "line"
          ]
        },
        "profile_id": {
          "type": "string"
        },
        "radius_cells": {
          "type": "integer"
        },
        "save_dc": {
          "type": "integer"
        }
      },
      "required": [
        "area_pattern",
        "profile_id",
        "radius_cells",
        "save_dc"
      ]
    },
    "SkillJsonDocumentDto": {
      "description": "Skill authoring document envelope. Entries use the strict stage-1a DTO plus the schema-only file-local template selector; templates are recursive partial views of that same DTO.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "const": "skills"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillJsonDto__authoring_skill_id_template_with_ContentJsonTemplateReferenceSchemaDto"
          }
        },
        "family": {
          "type": "string"
        },
        "schema": {
          "type": "integer",
          "const": 1
        },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SkillJsonDto__partial_with_ContentJsonTemplateReferenceSchemaDto"
          }
        }
      },
      "required": [
        "domain",
        "entries",
        "family",
        "schema",
        "templates"
      ]
    },
    "SkillJsonDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "combat_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/CombatSkillJsonDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "learn_source": {
          "type": "string",
          "enum": [
            "book",
            "innate",
            "internal",
            "player",
            "profession",
            "race",
            "subrace",
            "ascension",
            "bloodline"
          ]
        },
        "level_description_configs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "level_description_template": {
          "type": "string"
        },
        "max_level": {
          "type": "integer"
        },
        "skill_id": {
          "type": "string"
        },
        "skill_type": {
          "type": "string",
          "enum": [
            "active",
            "passive"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "display_name",
        "skill_id"
      ]
    },
    "SkillJsonDto__authoring_skill_id_template_with_ContentJsonTemplateReferenceSchemaDto": {
      "oneOf": [
        {
          "$ref": "#/$defs/SkillJsonDto"
        },
        {
          "$ref": "#/$defs/SkillJsonDto__templated_skill_id_template_with_ContentJsonTemplateReferenceSchemaDto"
        }
      ]
    },
    "SkillJsonDto__partial_with_ContentJsonTemplateReferenceSchemaDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "combat_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/CombatSkillJsonDto__partial"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "learn_source": {
          "type": "string",
          "enum": [
            "book",
            "innate",
            "internal",
            "player",
            "profession",
            "race",
            "subrace",
            "ascension",
            "bloodline"
          ]
        },
        "level_description_configs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "level_description_template": {
          "type": "string"
        },
        "max_level": {
          "type": "integer"
        },
        "skill_id": {
          "type": "string"
        },
        "skill_type": {
          "type": "string",
          "enum": [
            "active",
            "passive"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template": {
          "type": "string",
          "description": "Optional file-local template identifier consumed and removed by the template merger.",
          "pattern": "\\S"
        }
      }
    },
    "SkillJsonDto__templated_skill_id_template_with_ContentJsonTemplateReferenceSchemaDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "combat_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/CombatSkillJsonDto__partial"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "learn_source": {
          "type": "string",
          "enum": [
            "book",
            "innate",
            "internal",
            "player",
            "profession",
            "race",
            "subrace",
            "ascension",
            "bloodline"
          ]
        },
        "level_description_configs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "level_description_template": {
          "type": "string"
        },
        "max_level": {
          "type": "integer"
        },
        "skill_id": {
          "type": "string"
        },
        "skill_type": {
          "type": "string",
          "enum": [
            "active",
            "passive"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template": {
          "type": "string",
          "description": "Optional file-local template identifier consumed and removed by the template merger.",
          "pattern": "\\S"
        }
      },
      "required": [
        "skill_id",
        "template"
      ]
    },
    "SkillLevelOverrideJsonDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ap_cost": {
          "type": "integer"
        },
        "area_pattern": {
          "type": "string",
          "enum": [
            "single",
            "self",
            "diamond",
            "square",
            "radius",
            "cross",
            "line",
            "cone",
            "narrow_cone",
            "front_arc"
          ]
        },
        "area_value": {
          "type": "integer"
        },
        "attack_defense_mode": {
          "type": "string",
          "enum": [
            "normal",
            "touch",
            "flat_footed"
          ]
        },
        "attack_resolution_mode": {
          "type": "string",
          "enum": [
            "auto",
            "direct_effect",
            "fate_attack",
            "force_hit_no_crit"
          ]
        },
        "attack_roll_bonus": {
          "type": "integer"
        },
        "aura_cost": {
          "type": "integer"
        },
        "casting_maintenance_dc": {
          "type": "integer"
        },
        "casting_spell_control_dc": {
          "type": "integer"
        },
        "casting_time_tu": {
          "type": "integer"
        },
        "cooldown_tu": {
          "type": "integer"
        },
        "max_target_count": {
          "type": "integer"
        },
        "mp_cost": {
          "type": "integer"
        },
        "mp_cost_per_target_slot": {
          "type": "integer"
        },
        "pending_cast_binding_mode": {
          "type": "string",
          "enum": [
            "soft_anchor",
            "hard_anchor",
            "ground_bind"
          ]
        },
        "random_chain_attack_count": {
          "type": "integer"
        },
        "range_value": {
          "type": "integer"
        },
        "stamina_cost": {
          "type": "integer"
        },
        "stamina_cost_per_target_slot": {
          "type": "integer"
        }
      }
    },
    "SkillLevelOverrideJsonDto__partial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ap_cost": {
          "type": "integer"
        },
        "area_pattern": {
          "type": "string",
          "enum": [
            "single",
            "self",
            "diamond",
            "square",
            "radius",
            "cross",
            "line",
            "cone",
            "narrow_cone",
            "front_arc"
          ]
        },
        "area_value": {
          "type": "integer"
        },
        "attack_defense_mode": {
          "type": "string",
          "enum": [
            "normal",
            "touch",
            "flat_footed"
          ]
        },
        "attack_resolution_mode": {
          "type": "string",
          "enum": [
            "auto",
            "direct_effect",
            "fate_attack",
            "force_hit_no_crit"
          ]
        },
        "attack_roll_bonus": {
          "type": "integer"
        },
        "aura_cost": {
          "type": "integer"
        },
        "casting_maintenance_dc": {
          "type": "integer"
        },
        "casting_spell_control_dc": {
          "type": "integer"
        },
        "casting_time_tu": {
          "type": "integer"
        },
        "cooldown_tu": {
          "type": "integer"
        },
        "max_target_count": {
          "type": "integer"
        },
        "mp_cost": {
          "type": "integer"
        },
        "mp_cost_per_target_slot": {
          "type": "integer"
        },
        "pending_cast_binding_mode": {
          "type": "string",
          "enum": [
            "soft_anchor",
            "hard_anchor",
            "ground_bind"
          ]
        },
        "random_chain_attack_count": {
          "type": "integer"
        },
        "range_value": {
          "type": "integer"
        },
        "stamina_cost": {
          "type": "integer"
        },
        "stamina_cost_per_target_slot": {
          "type": "integer"
        }
      }
    }
  }
}
