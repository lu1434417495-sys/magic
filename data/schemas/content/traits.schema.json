    "TraitPassiveStatusEffectJsonDto": {
      "description": "One passive status declaration projected by a trait.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "counts_as_debuff": {
          "type": "boolean"
        },
        "counts_as_debuff_override": {
          "type": "boolean"
        },
        "display_label": {
          "type": "string"
        },
        "power": {
          "type": "integer"
        },
        "save_immunity_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stacks": {
          "type": "integer"
        },
        "status_id": {
          "type": "string"
        },
        "undispellable": {
          "type": "boolean"
        }
