      "description": "One base-attribute saving throw bonus.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bonus": {
          "type": "integer"
        },
        "save_ability": {
          "type": "string",
          "enum": [
            "strength",
            "agility",
            "constitution",
            "perception",
            "intelligence",
            "willpower"
