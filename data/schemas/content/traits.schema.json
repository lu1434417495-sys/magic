          ]
        },
        "highest_roll_compare_key": {
          "type": "string"
        },
        "passive_status_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraitPassiveStatusEffectJsonDto"
          }
        },
        "proficiency_choice_count": {
          "type": "integer"
        },
        "roll_value_schema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraitRollValueSchemaEntryJsonDto"
          }
        },
        "save_advantage_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "save_bonus_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraitSaveBonusEntryJsonDto"
          }
        },
        "save_disadvantage_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "save_immunity_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stack_policy": {
          "type": "string",
          "enum": [
            "unique_by_trait",
            "highest_roll",
            "additive",
            "stack_by_instance"
          ]
        },
        "trait_id": {
          "type": "string"
        },
        "trigger_type": {
          "type": "string",
          "enum": [
            "passive",
            "on_natural_one",
            "on_crit",
            "on_fatal_damage",
            "on_battle_start",
            "on_turn_start"
          ]
        },
        "vision_range": {
          "type": "integer"
        },
        "template": {
          "type": "string",
          "description": "Optional file-local template identifier consumed and removed by the template merger.",
          "pattern": "\\S"
        }
      }
    },
