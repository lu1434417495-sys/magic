    "TraitRollValueSchemaEntryJsonDto": {
      "description": "One typed per-instance trait roll value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key": {
          "type": "string"
        },
        "max_value": {
          "type": "integer"
        },
        "min_value": {
          "type": "integer"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "int",
            "string_name",
            "bool"
          ]
        }
      },
      "required": [
        "allowed_values",
        "key",
        "max_value",
        "min_value",
        "value_type"
      ]
    },
