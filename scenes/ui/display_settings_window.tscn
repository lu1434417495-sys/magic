[gd_scene load_steps=5 format=3]
; Scene purpose: Display settings modal scene for resolution and window mode controls.
; Review focus: verify external resources, root-node ownership, and major subtrees stay aligned.


; External scripts, scenes, and shared assets referenced by this scene.
[ext_resource type="Script" path="res://scripts/ui/DisplaySettingsWindow.cs" id="1_sx7p2"]
[ext_resource type="StyleBoxFlat" path="res://scenes/ui/styles/chronicle_panel.tres" id="2_panel_default"]

; Root node and primary scene tree.
[ext_resource type="Theme" path="res://scenes/ui/styles/chronicle_theme.tres" id="90_chronicle"]
[ext_resource type="Texture2D" path="res://assets/ui/character_creation/fate_observatory.png" id="91_art"]

[node name="DisplaySettingsWindow" type="Control"]
theme = ExtResource("90_chronicle")
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_sx7p2")
HeaderArtwork = ExtResource("91_art")

; Modal backdrop that dims the parent scene and blocks background input.
[node name="Shade" type="ColorRect" parent="."]
color = Color(0.018, 0.023, 0.03, 0.48)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

; Centered container that keeps the main panel anchored in the viewport.
[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(560, 360)
layout_mode = 2
theme_override_styles/panel = ExtResource("2_panel_default")

[node name="MarginContainer" type="MarginContainer" parent="CenterContainer/Panel"]
theme_override_constants/margin_bottom = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 26
theme_override_constants/margin_left = 26
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="CenterContainer/Panel/MarginContainer"]
