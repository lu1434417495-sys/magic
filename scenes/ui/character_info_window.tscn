[gd_scene load_steps=5 format=3]
; Scene purpose: Character info modal scene organizing summary, stats, and skill sections.
; Review focus: verify external resources, root-node ownership, and major subtrees stay aligned.


; External scripts, scenes, and shared assets referenced by this scene.
[ext_resource type="Script" path="res://scripts/ui/CharacterInfoWindow.cs" id="1_g81cw"]
[ext_resource type="StyleBoxFlat" path="res://scenes/ui/styles/chronicle_panel.tres" id="2_panel_default"]

; Root node and primary scene tree.
[ext_resource type="Theme" path="res://scenes/ui/styles/chronicle_theme.tres" id="90_chronicle"]
[ext_resource type="Texture2D" path="res://assets/ui/character_creation/fate_observatory.png" id="91_art"]

[node name="CharacterInfoWindow" type="Control"]
theme = ExtResource("90_chronicle")
visible = false
layout_mode = 3
