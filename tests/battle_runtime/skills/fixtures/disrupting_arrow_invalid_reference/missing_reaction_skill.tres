[gd_resource type="Resource" script_class="SkillDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="1_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSpellReactionDef.cs" id="2_reaction"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="3_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="4_skill"]

[sub_resource type="Resource" id="Resource_ready"]
script = ExtResource("1_effect")
effect_type = &"status"
status_id = &"missing_reaction_ready"
display_name = "缺失反应技能测试待机"
lifetime_policy = &"battle"

[sub_resource type="Resource" id="Resource_reaction"]
script = ExtResource("2_reaction")
trigger_delivery_category = &"spell"
reaction_skill_id = &"missing_standard_weapon_attack"
readiness_status_id = &"missing_reaction_ready"
required_weapon_family = &"bow"
save_ability = &"constitution"
save_tag = &"spell_maintenance"
base_save_dc = 10
hp_damage_divisor = 2
attack_roll_bonus_by_skill_level = PackedInt32Array(0, 0)
save_dc_bonus_by_skill_level = PackedInt32Array(0, 0)

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("3_combat")
skill_id = &"missing_reaction_reference_owner"
target_team_filter = &"self"
target_selection_mode = &"self"
required_weapon_families = Array[StringName]([&"bow"])
spell_reaction_profile = SubResource("Resource_reaction")
effect_defs = Array[ExtResource("1_effect")]([SubResource("Resource_ready")])

[resource]
script = ExtResource("4_skill")
skill_id = &"missing_reaction_reference_owner"
display_name = "缺失反应技能引用测试"
max_level = 1
non_core_max_level = 1
mastery_curve = PackedInt32Array(1)
combat_profile = SubResource("Resource_combat")
