"bonus_terrain_effect_id": 1,
"charge_trap_immunity_min_skill_level": 1,
"con_mod_sides": 1,
"consume_on_next_attack_check": 1,
"consume_on_next_save": 1,
"content_dr": 1,
"control_save_bonus": 1,
"counts_as_debuff": 1,
"counts_as_debuff_override": 1,
"dice_bonus": 1,
"dice_count": 1,
"dice_sides": 1,
"dice_sides_base": 1,
"dice_sides_per_constitution_mod": 1,
"dice_sides_per_willpower_mod": 1,
"dispellable_beneficial_magic": 1,
"dispellable_harmful_magic": 1,
"dispellable_magic": 1,
"dr_bypass_tag": 1,
"exclude_source": 1,
"fixed_attack_count": 1,
"follow_up_attack_roll_bonus_curve": 1,
"follow_up_damage_multiplier_percent": 1,
"free_move_points_gain": 1,
"guard_block": 1,
"heal_missing_hp_percent": 1,
"heal_multiplier_percent": 1,
"heal_to_hp_percent_floor": 1,
"hp_ratio_threshold_percent": 1,
"lifetime_policy": 1,
"lock_counterattack": 1,
"lock_crit": 1,
"lock_dodge_bonus": 1,
"lock_guard": 1,
"main_skill_lock_other_debuff_count": 1,
"max_affected_targets": 1,
"min_hp_after_damage": 1,
"mitigation_tier": 1,
"move_cost_delta": 1,
"passive_reduction": 1,
"prevent_repeat_target": 1,
"remove_beneficial": 1,
"remove_beneficial_from_enemies": 1,
"remove_harmful": 1,
"remove_harmful_from_allies": 1,
"require_damage_applied": 1,
