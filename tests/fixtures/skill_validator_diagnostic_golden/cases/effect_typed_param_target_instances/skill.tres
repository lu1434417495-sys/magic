"resolve_as_weapon_attack": 1,
"runtime_pre_resistance_damage_multiplier": 1,
"save_advantage_tags": 1,
"save_bonus": 1,
"save_disadvantage_tags": 1,
"save_immunity_tags": 1,
"save_tags": 1,
"secondary_hit_save_bonus": 1,
"shield_family": 1,
"shield_gain_multiplier_percent": 1,
"soul_fracture_duration_tu": 1,
"stop_on_miss": 1,
"stop_on_target_down": 1,
"target_order": 1,
"threshold_base_value": 1,
"threshold_cap_max_hp_ratio_percent": 1,
"threshold_level_anchor": 1,
"threshold_level_bonus_per_delta": 1,
"threshold_max_hp_ratio_percent": 1,
"undispellable": 1,
"use_weapon_physical_damage_tag": 1,
"wet_chain_radius": 1,
"will_mod_sides": 1
