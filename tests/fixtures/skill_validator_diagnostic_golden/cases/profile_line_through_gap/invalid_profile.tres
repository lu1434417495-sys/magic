[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatCastVariantDef.cs" id="1_variant"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatEffectDef.cs" id="2_effect"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatLineThroughAttackDef.cs" id="3_profile"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="4_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/ContingencyAutomationDef.cs" id="5_contingency"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="6_skill"]

[sub_resource type="Resource" id="EffectA"]
script = ExtResource("2_effect")
effect_type = &"damage"
damage_tag = &"fire"
dice_count = 1
dice_sides = 6

[sub_resource type="Resource" id="EffectB"]
script = ExtResource("2_effect")
effect_type = &"damage"
damage_tag = &"fire"
dice_count = 1
dice_sides = 6

[sub_resource type="Resource" id="Variant"]
script = ExtResource("1_variant")
variant_id = &"invalid"

[sub_resource type="Resource" id="Profile"]
script = ExtResource("3_profile")
maximum_weapon_range = 0
intermediate_weapon_dice_multiplier = 0
successful_intermediate_hit_bonus_weapon_dice = -1
successful_intermediate_hit_attack_roll_bonus = -1

[sub_resource type="Resource" id="Combat"]
script = ExtResource("4_combat")
skill_id = &"diagnostic_line_through_profile_gap"
target_mode = &"ground"
target_team_filter = &"ally"
target_selection_mode = &"multi_unit"
min_target_count = 0
max_target_count = 2
allow_repeat_target = true
max_hits_per_target = 2
weapon_range_policy = &"manual"
requires_los = false
range_value = 0
attack_roll_bonus = 1
allows_natural_weapon = true
fumble_protection_extra_mp_percent = 100
special_resolution_profile_id = &"invalid"
line_through_attack_profile = SubResource("Profile")
cast_variants = Array[ExtResource("1_variant")]([SubResource("Variant")])
effect_defs = Array[ExtResource("2_effect")]([SubResource("EffectA"), SubResource("EffectB")])

[sub_resource type="Resource" id="Contingency"]
script = ExtResource("5_contingency")
can_be_stored_in_contingency = true

[resource]
script = ExtResource("6_skill")
skill_id = &"diagnostic_line_through_profile_gap"
display_name = "Line-through profile diagnostic fixture"
icon_id = &"diagnostic_line_through_profile_gap"
description = "T1a.7 diagnostic fixture."
mastery_curve = PackedInt32Array(10)
tags = Array[StringName]([&"test"])
combat_profile = SubResource("Combat")
contingency_automation_profile = SubResource("Contingency")
