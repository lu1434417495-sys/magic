[gd_resource type="Resource" script_class="SkillDef" format=3]

[ext_resource type="Script" path="res://scripts/player/progression/CombatCastVariantDef.cs" id="1_variant"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSequentialLineHitDef.cs" id="2_profile"]
[ext_resource type="Script" path="res://scripts/player/progression/CombatSkillDef.cs" id="3_combat"]
[ext_resource type="Script" path="res://scripts/player/progression/ContingencyAutomationDef.cs" id="4_contingency"]
[ext_resource type="Script" path="res://scripts/player/progression/SkillDef.cs" id="5_skill"]

[sub_resource type="Resource" id="Variant"]
script = ExtResource("1_variant")
variant_id = &"invalid"

[sub_resource type="Resource" id="Profile"]
script = ExtResource("2_profile")

[sub_resource type="Resource" id="Combat"]
script = ExtResource("3_combat")
skill_id = &"diagnostic_sequential_line_profile_gap"
target_mode = &"ground"
target_team_filter = &"ally"
target_selection_mode = &"multi_unit"
min_target_count = 0
max_target_count = 1
allow_repeat_target = true
max_hits_per_target = 2
weapon_range_policy = &"manual"
requires_los = false
projectile_kind = &"physical"
attack_resolution_mode = &"direct_effect"
required_weapon_families = Array[StringName]([&"sword"])
allows_natural_weapon = true
range_value = 0
fumble_protection_extra_mp_percent = 100
special_resolution_profile_id = &"invalid"
sequential_line_hit_profile = SubResource("Profile")
cast_variants = Array[ExtResource("1_variant")]([SubResource("Variant")])

[sub_resource type="Resource" id="Contingency"]
script = ExtResource("4_contingency")
can_be_stored_in_contingency = true

[resource]
script = ExtResource("5_skill")
skill_id = &"diagnostic_sequential_line_profile_gap"
display_name = "Sequential-line profile diagnostic fixture"
icon_id = &"diagnostic_sequential_line_profile_gap"
description = "T1a.7 diagnostic fixture."
max_level = 0
mastery_curve = PackedInt32Array()
tags = Array[StringName]([&"test"])
combat_profile = SubResource("Combat")
contingency_automation_profile = SubResource("Contingency")
